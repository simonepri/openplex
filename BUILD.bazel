"""Root build file defining Gazelle code generation rules, buildifier targets, and monorepo source sets."""

load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load(
    "//src/bazel/rules:constants.bzl",
    "ARGOCD_LINKS_PATH_SPECS",
    "CODEOWNERS_PATH_SPECS",
    "DOTENV_PATH_SPECS",
    "GAZELLE_PATH_SPECS",
    "RULESYNC_PATH_SPECS",
)
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "GENERATED", "package_sources", "source_set")
load("//src/bazel/rules/git_hooks:defs.bzl", "git_hook", "git_hooks")
load("//src/bazel/rules/json_schema:defs.bzl", "json_schema")
load("//src/bazel/rules/lint_aspect:defs.bzl", "check_all", "format_all")

# gazelle:exclude .github
# gazelle:exclude .tmp
# gazelle:exclude .venv
# gazelle:exclude src/bazel/gazelle
npm_link_all_packages(name = "node_modules")

gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@gazelle//language/go",
        "//src/bazel/gazelle/python",
        "//src/bazel/gazelle/opentofu",
        "//src/bazel/gazelle/gitops",
    ],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
)

git_hook(
    name = "coverage",
    src = "//src/bazel/checks:unclaimed_files",
    stage = "pre-commit",
    summary = "Every file is in the Bazel graph",
)

git_hook(
    name = "argocd_links",
    src = "//src/bazel/checks/argocd_links",
    pathspecs = ARGOCD_LINKS_PATH_SPECS,
    stage = "pre-commit",
    summary = "Every component and value link is valid",
)

git_hook(
    name = "gazelle_drift",
    src = "//:gazelle",
    args = ["--mode=diff"],
    pathspecs = GAZELLE_PATH_SPECS,
    stage = "pre-commit",
    summary = "BUILD targets match Gazelle",
)

git_hook(
    name = "codeowners",
    src = "//src/bazel/checks/records:codeowners",
    pathspecs = CODEOWNERS_PATH_SPECS,
    stage = "pre-commit",
    summary = "Every record has an owner",
)

git_hook(
    name = "source_names",
    src = "//src/bazel/checks/source_names",
    stage = "pre-commit",
    summary = "Source names project to Kubernetes-safe names",
)

git_hook(
    name = "dev_tool_isolation",
    src = "//src/bazel/checks:dev_tool_isolation",
    stage = "pre-commit",
    summary = "Dev-tool locks stay out of shipped images",
)

git_hook(
    name = "dotenv",
    src = "//src/bazel/checks:dotenv",
    pass_staged_files = True,
    pathspecs = DOTENV_PATH_SPECS,
    stage = "pre-commit",
    summary = "Dotenv files are valid and consistently styled",
    tool = "//src/bazel/tools:dotenv-linter",
)

git_hook(
    name = "function_length",
    src = "//src/bazel/checks/function_length",
    stage = "pre-commit",
    summary = "Production functions do not exceed 120 lines",
)

git_hook(
    name = "semgrep",
    src = "//src/bazel/checks:opengrep",
    args = ["src/bazel/checks/opengrep/rules.yaml"],
    pass_staged_files = True,
    stage = "pre-commit",
    summary = "OpenGrep baseline",
    tool = "//src/bazel/tools:opengrep",
)

git_hook(
    name = "ifttt",
    src = "//src/bazel/checks:ifttt",
    stage = "pre-commit",
    summary = "LINT.IfChange and LINT.ThenChange consistency",
)

git_hook(
    name = "json_schemas",
    src = "//src/bazel/checks:json_schemas",
    pass_staged_files = True,
    pathspecs = ["'*.schema.json'"],
    stage = "pre-commit",
    summary = "JSON schemas conform to metaschema",
    tool = "//src/bazel/tools:check-jsonschema",
)

git_hook(
    name = "rulesync",
    src = "//src/bazel/checks/rulesync",
    pathspecs = RULESYNC_PATH_SPECS,
    stage = "pre-commit",
    summary = "RuleSync guidance drift",
)

git_hook(
    name = "rulesync_post_checkout",
    src = "//src/bazel/checks/rulesync",
    args = ["--fix"],
    stage = "post-checkout",
    summary = "Regenerate RuleSync agent guidance after checkout",
)

git_hook(
    name = "rulesync_post_merge",
    src = "//src/bazel/checks/rulesync",
    args = ["--fix"],
    stage = "post-merge",
    summary = "Regenerate RuleSync agent guidance after merge",
)

git_hooks(
    name = "hooks",
    testonly = True,
    srcs = [
        # keep-sorted start
        ":argocd_links",
        ":codeowners",
        ":commit_message",
        ":coverage",
        ":dev_tool_isolation",
        ":dotenv",
        ":function_length",
        ":gazelle_drift",
        ":ifttt",
        ":json_schemas",
        ":rulesync",
        ":rulesync_post_checkout",
        ":rulesync_post_merge",
        ":semgrep",
        ":source_names",
        # keep-sorted end
    ],
)

git_hook(
    name = "commit_message",
    src = "//src/bazel/checks:commit_message_check",
    stage = "commit-msg",
    summary = "Check the commit message",
    tool = "//src/bazel/tools:committed",
)

# pnpm writes these; a formatter that rewrites them fights the package manager.
source_set(
    name = "generated_locks",
    srcs = [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
    ],
    kind = GENERATED,
)

package_sources(exclude = [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

exports_files([
    # keep-sorted start
    ".bazelrc",
    "buildbuddy.yaml",
    # keep-sorted end
])

format_all(
    name = "fix",
    formatters = [
        ("//src/bazel/tools:taplo", "'*.toml'", "fmt"),
        ("//src/bazel/tools:keep-sorted", "'*'", "--mode fix"),
        (
            "//src/bazel/tools:tofu",
            "'src/infra/terraform/**/*.tf' 'src/infra/argocd/**/*.tf'",
            "fmt -no-color",
            True,
        ),
        ("//src/bazel/tools:shfmt", "'*.sh'", "-i 2 -ci -bn -s -w"),
        # Helm templates and Chainsaw suites are excluded: the first is Go
        # template text, the second is authored to Chainsaw's own shape.
        (
            "//src/bazel/tools:yamlfmt",
            "'*.yaml' '*.yml' ':!**/*.generated.yaml' ':!*/templates/*' ':!src/infra/argocd/apps/*' ':!src/infra/definitions/conformance/*' ':!pnpm-lock.yaml' ':!pnpm-workspace.yaml' ':!*/helm/lint-values-cell-*.yaml'",
            "-conf src/bazel/aspects/yaml/yamlfmt.yaml",
        ),
        ("//src/bazel/tools:ruff", "'*.py'", "format --config src/bazel/aspects/python/ruff.toml"),
        (
            "//src/bazel/tools:oxfmt",
            "'*.json' 'src/**/*.ts' 'src/**/*.tsx' 'src/**/*.js' 'src/**/*.jsx' 'src/**/*.mjs'",
            "",
        ),
        ("//src/bazel/tools:rumdl", "'*.md'", "fmt --config src/bazel/aspects/markdown/rumdl.toml"),
        (
            "//src/bazel/tools:buildifier",
            "'BUILD' 'BUILD.bazel' 'MODULE.bazel' '*.bzl' '**/BUILD' '**/BUILD.bazel' '**/*.bzl'",
            "-mode=fix -lint=fix",
        ),
    ],
)

check_all(
    name = "check",
    checks = [
        "//src/bazel/checks:unclaimed_files",
        "//src/bazel/checks/cluster_network",
        "//src/bazel/checks/records:codeowners",
        "//src/bazel/checks/source_names:source_names",
        "//src/bazel/checks/records:team_records",
        "//src/bazel/checks/workload_portability:workload_portability",
        "//src/bazel/checks/network_exposure:network_exposure",
        (
            "//src/bazel/checks:opengrep",
            "//src/bazel/tools:opengrep",
        ),
        "//src/bazel/checks:dev_tool_isolation",
        (
            "//src/bazel/checks:dotenv",
            "//src/bazel/tools:dotenv-linter",
        ),
        (
            "//src/bazel/checks:json_schemas",
            "//src/bazel/tools:check-jsonschema",
        ),
        "//src/bazel/checks/argocd_links",
        "//src/bazel/checks:coder_templates",
        "//src/bazel/checks:license_images",
        "//src/bazel/checks:license_source",
        "//src/bazel/checks:trivy_source",
        (
            "//src/bazel/checks:kubescape",
            "//src/bazel/tools:kubescape",
        ),
        "//src/bazel/checks:ifttt",
        "//src/bazel/checks/rulesync",
        "//src/bazel/checks:gazelle_drift",
        "//src/bazel/checks/function_length",
        "//src/bazel/checks:lock_drift",
        "//src/bazel/checks:dups",
        "//src/bazel/checks:cyclo",
    ],
    pre_commands = [
        "bazel --output_user_root=\"${BAZEL_OUTPUT_ROOT}\" build ${BAZEL_CONFIG_FLAGS:-} --remote_download_regex='.*_render.*\\.yaml' -- //...",
    ],
    tools = {
        # keep-sorted start block=yes
        "//src/bazel/checks/rulesync": ["//src/bazel/tools:rulesync"],
        "//src/bazel/checks:coder_templates": ["//src/bazel/tools:jq"],
        "//src/bazel/checks:cyclo": ["//src/bazel/tools:gocyclo"],
        "//src/bazel/checks:dev_tool_isolation": ["//src/bazel/tools:jq"],
        "//src/bazel/checks:dups": ["//src/bazel/tools:jscpd"],
        "//src/bazel/checks:ifttt": ["//src/bazel/tools:ifttt-lint"],
        "//src/bazel/checks:kubescape": ["//src/bazel/tools:jq"],
        "//src/bazel/checks:license_images": ["//src/bazel/tools:trivy"],
        "//src/bazel/checks:license_source": [
            "//src/bazel/tools:jq",
            "//src/bazel/tools:osv-scanner",
        ],
        "//src/bazel/checks:lock_drift": [
            "//src/bazel/tools:pnpm",
            "//src/bazel/tools:uv",
        ],
        "//src/bazel/checks:opengrep": ["//src/bazel/tools:jq"],
        "//src/bazel/checks:trivy_source": [
            "//src/bazel/tools:jq",
            "//src/bazel/tools:trivy",
        ],
        # keep-sorted end
    },
)

json_schema(
    name = "package_schema",
    srcs = ["package.json"],
    schema = "@package_json_schema//file:package.schema.json",
)

alias(
    name = "test",
    actual = "//src/bazel/tools/diff:cli",
)
