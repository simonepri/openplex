# Defines Git attributes for line ending normalization and marks generated dependency locks for diff filtering.

* text=auto eol=lf

# Generated dependency locks. Keep merge conflicts explicit and exclude these
# files from GitHub language statistics and human-oriented diffs.
MODULE.bazel.lock merge=binary linguist-generated=true
Chart.lock merge=binary linguist-language=YAML linguist-generated=true
.terraform.lock.hcl merge=binary linguist-language=HCL linguist-generated=true

# RuleSync-generated agent context. Canonical sources live in rules.rulesync.md and *.rulesync.md files.
AGENTS.md linguist-generated=true
CLAUDE.md linguist-generated=true
**/AGENTS.md linguist-generated=true
.agents/memories/** linguist-generated=true
.agents/skills/** linguist-generated=true
.claude/rules/** linguist-generated=true
.claude/skills/** linguist-generated=true
.rulesync/generated-files.json linguist-generated=true

# Code-generator outputs. .tmp/ is normally ignored, but these attributes
# remain correct if an artifact is force-added for debugging.
*.gen.* linguist-generated=true
**/generated/** linguist-generated=true
**/*_pb2.py linguist-generated=true
**/*_pb2.pyi linguist-generated=true
**/*_pb.js linguist-generated=true
**/*_pb.ts linguist-generated=true
requirements_lock.txt merge=binary linguist-generated=true

# Unified diff context uses one leading space for blank context lines.
src/bazel/patches/rules_helm_chart_relative_files.patch whitespace=-blank-at-eol,-blank-at-eof
src/bazel/patches/rules_tf_provider_plugins_and_mirror.patch whitespace=-blank-at-eol,-blank-at-eof
src/infra/images/buildbuddy/buildbuddy.patch whitespace=-blank-at-eol,-blank-at-eof
src/third_party/dragonflyoss/client/source-date-epoch-v1.5.2.patch whitespace=-blank-at-eol,-blank-at-eof

# Media assets tracked by Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text

