# The one npm-backed tool: mmdlint parses Mermaid blocks with Mermaid's own
# grammar, which has no standalone binary, so it resolves through the root npm
# workspace rather than multitool.
mmdlint.mmdlint_binary(
    name = "mmdlint",
    visibility = ["//visibility:public"],
)

# select() cannot nest, so each os/cpu pair gets its own config_setting.
[
    config_setting(
        name = "taplo_%s" % suffix,
        constraint_values = values,
    )
    for suffix, values in {
        "macos_arm64": [
            "@platforms//os:macos",
            "@platforms//cpu:arm64",
        ],
        "macos_x86_64": [
            "@platforms//os:macos",
            "@platforms//cpu:x86_64",
        ],
        "linux_arm64": [
            "@platforms//os:linux",
            "@platforms//cpu:arm64",
        ],
        "linux_x86_64": [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
    }.items()
]

gunzip(
    name = "taplo",
    src = select({
        ":taplo_macos_arm64": "@taplo_macos_arm64//file",
        ":taplo_macos_x86_64": "@taplo_macos_x86_64//file",
        ":taplo_linux_arm64": "@taplo_linux_arm64//file",
        ":taplo_linux_x86_64": "@taplo_linux_x86_64//file",
    }),
    out = "taplo_bin",
    visibility = ["//visibility:public"],
)

package_sources()
