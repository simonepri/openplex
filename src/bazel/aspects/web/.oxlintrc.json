{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "rules": {
    "ban-ts-comment": "error",
    "complexity": ["error", 10],
    "consistent-type-assertions": ["error", { "assertionStyle": "as" }],
    "consistent-type-imports": "error",
    "consistent-type-specifier-style": "off",
    "eqeqeq": "error",
    "explicit-function-return-type": ["error", { "allowExpressions": false }],
    "explicit-module-boundary-types": "error",
    "exports-last": "off",
    "func-style": "off",
    "group-exports": "off",
    "init-declarations": "off",
    "max-classes-per-file": "off",
    "max-dependencies": "off",
    "max-depth": ["error", 5],
    "max-lines": ["error", 500],
    "max-lines-per-function": ["error", { "max": 80 }],
    "max-params": ["error", 5],
    "max-statements": ["error", 60],
    "no-async-await": "off",
    "no-console": "error",
    "no-default-export": "off",
    "no-duplicate-imports": "error",
    "no-empty-interface": "error",
    "no-explicit-any": ["error", { "ignoreRestArgs": false }],
    "no-inferrable-types": "error",
    "no-magic-numbers": "off",
    "no-named-export": "off",
    "no-nodejs-modules": "off",
    "no-non-null-asserted-nullish-coalescing": "error",
    "no-non-null-assertion": "error",
    "no-null": "off",
    "no-optional-chaining": "off",
    "no-restricted-types": [
      "error",
      {
        "types": {
          "unknown": { "message": "Use a concrete type or generic parameter instead of unknown." },
          "{}": { "message": "Use Record<string, T> or an interface instead of {}." },
          "Object": { "message": "Use an interface or Record<string, T> instead of Object." },
          "Function": { "message": "Use an explicit function signature instead of Function." }
        }
      }
    ],
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "no-ternary": "off",
    "no-throw-literal": "error",
    "no-typeof-undefined": "error",
    "no-undefined": "off",
    "no-unneeded-ternary": "error",
    "no-unsafe-argument": "error",
    "no-unsafe-assignment": "error",
    "no-unsafe-call": "error",
    "no-unsafe-member-access": "error",
    "no-unsafe-return": "error",
    "no-unsafe-type-assertion": "error",
    "no-useless-undefined": "error",
    "no-var": "error",
    "no-void": "off",
    "one-var": "off",
    "prefer-as-const": "error",
    "prefer-const": "error",
    "prefer-default-export": "off",
    "prefer-object-has-own": "error",
    "prefer-ts-expect-error": "error",
    "sort-imports": "off",
    "sort-keys": "off"
  }
}
