"""Define non-hermetic workspace check binaries, test suites, and policy packages for repository gates."""

load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/json_schema:defs.bzl", "json_schema")

# These Python files are inputs to workspace-driven shell checks, not Python
# entry points. The parent package owns and lints them as source data.
# gazelle:exclude license_images
# gazelle:exclude kubescape/kubescape_triage.py
# gazelle:exclude opengrep/fixtures/subprocess_shell_true.py
# gazelle:exclude trivy_source/trivy_triage.py

exports_files([
    "license_images/exceptions.yaml",
    "license_images/normalize-debian.yaml",
    "license_images/osv-scanner.toml",
    "license_images/ray-base-exception.json",
])

sh_library(
    name = "scripts",
    srcs = glob(["*/*.sh"]),
    visibility = ["//visibility:public"],
)

package_sources()

# Shell checks whose whole interface is the workspace.
[
    sh_binary(
        name = check + "_check",
        srcs = ["%s/%s.sh" % (check, check)],
        visibility = ["//visibility:public"],
    )
    for check in [
        # keep-sorted start
        "coder_templates",
        "cyclo",
        "dev_tool_isolation",
        "dups",
        "ifttt",
        "lock_drift",
        "unclaimed_files",
        # keep-sorted end
    ]
]

[
    alias(
        name = check,
        actual = ":" + check + "_check",
        visibility = ["//visibility:public"],
    )
    for check in [
        # keep-sorted start
        "coder_templates",
        "cyclo",
        "dev_tool_isolation",
        "dups",
        "ifttt",
        "lock_drift",
        "unclaimed_files",
        # keep-sorted end
    ]
]

sh_binary(
    name = "dotenv_check",
    srcs = ["dotenv/dotenv.sh"],
    args = ["$(rootpath //src/bazel/tools:dotenv-linter)"],
    data = ["//src/bazel/tools:dotenv-linter"],
    visibility = ["//visibility:public"],
)

alias(
    name = "dotenv",
    actual = ":dotenv_check",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "dotenv_test",
    srcs = ["dotenv/dotenv_test.sh"],
    args = [
        "$(rootpath :dotenv_check)",
        "$(rootpath //src/bazel/tools:dotenv-linter)",
    ],
    data = [
        ":dotenv_check",
        "//src/bazel/tools:dotenv-linter",
    ],
)

sh_binary(
    name = "json_schemas_check",
    srcs = ["json_schemas/json_schemas.sh"],
    args = ["$(rootpath //src/bazel/tools:check-jsonschema)"],
    data = ["//src/bazel/tools:check-jsonschema"],
    visibility = ["//visibility:public"],
)

alias(
    name = "json_schemas",
    actual = ":json_schemas_check",
    visibility = ["//visibility:public"],
)

sh_test(
    name = "json_schemas_test",
    srcs = ["json_schemas/json_schemas_test.sh"],
    args = [
        "$(rootpath :json_schemas_check)",
        "$(rootpath //src/bazel/tools:check-jsonschema)",
    ],
    data = [
        ":json_schemas_check",
        "//src/bazel/tools:check-jsonschema",
