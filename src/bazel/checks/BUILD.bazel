# One Trivy license report per pinned image, scanned from the OCI layout Bazel
# already pulled. The scan is offline, so its cache key is the image content,
# Trivy, and the scan script, and any runner reuses a remote cache hit.
[
    genrule(
        name = repo + "_license_report",
        srcs = ["@" + repo],
        outs = ["license_images/reports/%s.json" % repo],
        cmd = " ".join([
            "$(location license_images/scan_image.sh)",
            "$(location //src/bazel/tools:trivy)",
            "$(location //src/bazel/tools:jq)",
            image,
            "$(location @%s)" % repo,
            "$@",
        ]),
        tags = ["block-network"],
        tools = [
            "license_images/scan_image.sh",
            "//src/bazel/tools:jq",
            "//src/bazel/tools:trivy",
        ],
    )
    for repo, image in LICENSE_IMAGES.items()
]

# The gate reads the reports that the //... build of //:check left in bazel-bin,
# or builds them itself when run alone: as runfiles, every run of //:check would
# fetch all base images to look the reports up.
filegroup(
    name = "license_image_reports",
    srcs = [":" + repo + "_license_report" for repo in LICENSE_IMAGES],
)

filegroup(
    name = "license_policy_data",
    srcs = [
        "license_images/exceptions.yaml",
        "license_images/normalize-debian.yaml",
        "license_images/policy.json",
    ] + glob(["license_images/*-exception.json"]),
)

[
    py_test(
        name = repo + "_license_test",
        size = "small",
        srcs = ["license_images/check_image_licenses.py"],
        args = [
            "--report",
            "$(rootpath :%s_license_report)" % repo,
            "--image",
            image,
            "--repo",
            repo,
        ],
        data = [
            ":%s_license_report" % repo,
            ":license_policy_data",
        ],
        main = "license_images/check_image_licenses.py",
        deps = [
            "@dev_python_deps//pyyaml",
        ],
    )
    for repo, image in LICENSE_IMAGES.items()
]

