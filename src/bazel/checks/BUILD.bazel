# Evidence files are named <subject>-exception.json beside the exceptions they
# support; the glob keeps a newly added one from escaping validation, which a
# hand-listed set would not.
json_schema(
    name = "license_evidence_schema",
    srcs = glob(["license_images/*-exception.json"]),
    schema = "license_images/license-evidence.schema.json",
)

