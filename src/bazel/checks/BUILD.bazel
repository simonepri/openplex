# Proves a known violation is a hard failure, independent of the clean scan.
sh_test(
    name = "opengrep_regression",
    # The engine's startup and rule loading exceed the small 60s budget.
    size = "medium",
    srcs = ["opengrep/regression_test.sh"],
    args = [
        "$(rootpath //src/bazel/tools:opengrep)",
        "$(rootpath :opengrep/rules.yaml)",
        "$(rootpath //src/bazel/tools:jq)",
        "$(rootpath :opengrep/fixtures/subprocess_shell_true.py)",
    ],
    data = [
        ":opengrep/fixtures/subprocess_shell_true.py",
        ":opengrep/rules.yaml",
        "//src/bazel/tools:jq",
        "//src/bazel/tools:opengrep",
    ],
)

