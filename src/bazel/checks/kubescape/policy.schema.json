{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KubescapePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "schemaVersion",
    "intentionalSecurityNegativeFixtures",
    "ordinaryConformanceFixtureRules",
    "reviewedExceptions"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "intentionalSecurityNegativeFixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ordinaryConformanceFixtureRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "suffix", "reason"],
        "properties": {
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "reviewedExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlID", "controlName", "kind", "namespace", "reason"],
        "properties": {
          "controlID": {
            "type": "string"
          },
          "controlName": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namePrefix": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
