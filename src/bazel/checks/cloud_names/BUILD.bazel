"""Define test, binary, and policy validation targets for cloud object and container naming conventions."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")

# Flat-module imports; targets are hand-wired.
# gazelle:exclude .

package(default_visibility = ["//visibility:public"])

package_sources()

exports_files(["allowlist.yaml"])

py_library(
    name = "validators",
    # keep
    srcs = ["check_cloud_names.py"],
    data = ["allowlist.yaml"],
    imports = ["."],
    visibility = ["//src/bazel/checks:__subpackages__"],
    # keep
    deps = [
        "@dev_python_deps//python_hcl2",
        "@dev_python_deps//pyyaml",
    ],
)

py_binary(
    name = "cloud_names",
    # keep
    srcs = ["check_cloud_names.py"],
    data = ["allowlist.yaml"],
    imports = ["."],
    main = "check_cloud_names.py",
    precompile = "disabled",
    visibility = ["//visibility:public"],
    # keep
    deps = [
        ":validators",
    ],
)

py_test(
    name = "check_cloud_names_test",
    size = "small",
    # keep
    srcs = ["check_cloud_names_test.py"],
    data = ["allowlist.yaml"],
    imports = ["."],
    main = "check_cloud_names_test.py",
    precompile = "disabled",
    # keep
    deps = [
        ":validators",
    ],
)
