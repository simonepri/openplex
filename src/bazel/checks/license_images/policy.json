  "reviewBasis": {
    "bazelModules": "The exact direct module coordinates are Apache-2.0 at their pinned upstream projects; MODULE.bazel.lock transitive modules remain an explicitly uncovered class.",
    "terraformProviders": "Every provider coordinate in every repository lock has an exact upstream-project license review; MPL-2.0 provider executables remain separate from authored OpenTofu configuration, the Tailscale provider is MIT, and the first-party HKDF provider carries its colocated Apache-2.0 license.",
    "vendorHelmCharts": "Each exact parent chart coordinate has an upstream-project license review; archives can omit license files and bundled subcharts remain an explicitly uncovered class."
  },
  "sourceScan": {
    "targets": [
      {
        "context": "dev-tool",
        "entrypoint": "mise run check",
        "path": "requirements_dev_lock.txt"
      },
      {
        "context": "shipped-source",
        "path": "pnpm-lock.yaml"
      },
      {
        "context": "shipped-source",
        "path": "requirements_lock.txt"
      }
    ]
  },
  "unsupportedDependencyClasses": {
    "bazelTransitiveModules": "MODULE.bazel.lock is not a supported OSV-Scanner manifest and its registry hash inventory contains considered as well as selected versions; exact direct modules are reviewed, but resolved transitive modules are not license-covered.",
    "terraformProviders": ".terraform.lock.hcl is not a supported OSV-Scanner manifest and Trivy does not catalog provider licenses from it; every checked-in lock is parsed and providers are covered by exact source-address and version reviews.",
    "vendorHelmCharts": "The pinned chart archives generally omit license metadata and neither Trivy nor OSV-Scanner resolves their upstream project license; every exact chart coordinate needs an explicit reviewed license record."
  }
}
