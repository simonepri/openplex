{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrivySourcePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "schemaVersion",
    "intentionalSecurityNegativeFixtures",
    "ordinaryConformanceFixtureRules",
    "scannerRuleExceptions",
    "scannerFalsePositives",
    "exceptions"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "intentionalSecurityNegativeFixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ordinaryConformanceFixtureRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "suffix", "reason"],
        "properties": {
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scannerRuleExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "reason"],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scannerFalsePositives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "id", "reason", "evidence"],
        "properties": {
          "path": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
