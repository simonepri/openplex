// Configures RuleSync targets and output roots to synchronize agent guidance across tools.

{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/download/v13.0.0/config-schema.json",
  "outputRoots": ["."],
  "targets": {
    "claudecode": ["*"],
    "antigravity-cli": ["*"],
    "codexcli": ["hooks", "mcp", "skills", "commands", "permissions"]
  },
  "delete": false
}
