+def parse_provider_lock(content):
+    """Collects the `zh:` hashes of each provider block in a lock file.
+
+    The file concatenates `tofu providers lock` output, one block per
+    coordinate, so blocks are keyed by `source:version` rather than source.
+    """
+    hashes = {}
+    current = None
+    source = None
+    for line in content.splitlines():
+        line = line.strip()
+        if line.startswith("provider \"registry.opentofu.org/"):
+            source = line.split("\"")[1].removeprefix("registry.opentofu.org/")
+        elif source != None and line.startswith("version ") and current == None:
+            current = "{}:{}".format(source, line.split("\"")[1])
+            hashes[current] = []
+        elif current != None and line.startswith("\"zh:"):
+            hashes[current].append(line.split("\"")[1].removeprefix("zh:"))
+        elif line == "}":
+            current = None
+            source = None
+    return hashes
+
+def resolve_provider_archives(module_ctx, mirror, os, arch, provider_lock):
+    """Resolves each mirror coordinate to its registry archive URL and sha256.
+
+    Module extensions call this so the lockfile records the resolved
+    archives and repository fetches download them by checksum. Each sha256
+    must appear among the coordinate's `zh:` hashes in `provider_lock`,
+    which `tofu providers lock` takes from the GPG-verified SHA256SUMS of
+    the provider release, so the registry response alone is never trusted.
+    """
+    if provider_lock == None:
+        fail("tf.download(use_tofu = True) requires provider_lock, a file of `tofu providers lock` output covering every mirror coordinate")
+    locked = parse_provider_lock(module_ctx.read(provider_lock))
+    archives = {}
+    for key, provider in parse_mirror(mirror).items():
+        coordinate = "{}:{}".format(provider["source"], provider["version"])
+        if coordinate not in locked:
+            fail("provider {} ({}) has no block in {}; regenerate it as its header describes".format(
+                key,
+                coordinate,
+                provider_lock,
+            ))
+        package = "provider-packages/{}.json".format(key)
+        module_ctx.download(
+            url = "https://registry.opentofu.org/v1/providers/{}/{}/download/{}/{}".format(
+                provider["source"],
+                provider["version"],
+                os,
+                arch,
+            ),
+            output = package,
+        )
+        metadata = json.decode(module_ctx.read(package))
+        if metadata["shasum"] not in locked[coordinate]:
+            fail("registry sha256 {} for provider {} ({}) on {}_{} is not among its zh: hashes in {}; refusing an archive that does not match the GPG-verified lock".format(
+                metadata["shasum"],
+                key,
+                coordinate,
+                os,
+                arch,
+                provider_lock,
+            ))
+        archives[key] = [metadata["download_url"], metadata["shasum"]]
+    return archives
 
