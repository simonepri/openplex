diff --git a/tf/rules/provider-plugins.bzl b/tf/rules/provider-plugins.bzl
new file mode 100644
--- /dev/null
+++ b/tf/rules/provider-plugins.bzl
@@ -0,0 +1,51 @@
+"""Builds a writable provider mirror containing first-party plugins."""
+
+def provider_plugin_setup(ctx, mirror):
+    if not ctx.attr.provider_plugins:
+        return struct(
+            command = "",
+            deps = [],
+            directory = "$PWD/{}".format(mirror),
+        )
+
+    commands = [
+        "set -e",
+        'provider_plugin_dir="${TEST_TMPDIR}/provider-plugins"',
+        'provider_mirror="$PWD/{}"'.format(mirror),
+        'mkdir -p "${provider_plugin_dir}"',
+        '(cd "${provider_mirror}" && find . -type d -print) | while IFS= read -r provider_directory; do mkdir -p "${provider_plugin_dir}/${provider_directory}"; done',
+        '(cd "${provider_mirror}" && find . -type f -print) | while IFS= read -r provider_file; do ln -s "${provider_mirror}/${provider_file}" "${provider_plugin_dir}/${provider_file}"; done',
+        'case "$(uname -s):$(uname -m)" in',
+        '  Darwin:arm64) provider_platform="darwin_arm64" ;;',
+        '  Linux:x86_64) provider_platform="linux_amd64" ;;',
+        '  Linux:aarch64|Linux:arm64) provider_platform="linux_arm64" ;;',
+        '  *) echo "unsupported provider platform: $(uname -s):$(uname -m)" >&2; exit 1 ;;',
+        "esac",
+    ]
+    deps = []
+    for target, address in ctx.attr.provider_plugins.items():
+        address_parts = address.split("/")
+        if len(address_parts) != 4:
+            fail("provider plugin address must be host/namespace/name/version, was: {}".format(address))
+        provider_files = target[DefaultInfo].files.to_list()
+        if len(provider_files) != 1:
+            fail("provider plugin target must produce one file, was: {}".format(target.label))
+        provider_file = provider_files[0]
+        provider_name = address_parts[2]
+        provider_version = address_parts[3]
+        commands.extend([
+            'provider_install_dir="${{provider_plugin_dir}}/{}/$provider_platform"'.format(address),
+            'mkdir -p "${provider_install_dir}"',
+            'install -m 0755 "$PWD/{}" "${{provider_install_dir}}/terraform-provider-{}_v{}"'.format(
+                provider_file.short_path,
+                provider_name,
+                provider_version,
+            ),
+        ])
+        deps.append(provider_file)
+
+    return struct(
+        command = "\n".join(commands) + "\n",
+        deps = deps,
+        directory = "${provider_plugin_dir}",
+    )
