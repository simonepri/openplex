+def _chart_relative_file_destination(file, chart, package_path):
+    if chart == None:
+        fail("Helm file assets require a source Chart.yaml")
+
+    chart_root = chart.dirname
+    chart_prefix = chart_root + "/" if chart_root != "." else ""
+    if not file.path.startswith(chart_prefix):
