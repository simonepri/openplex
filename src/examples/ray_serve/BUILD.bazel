"""Builds the Ray Serve PyTorch inference service and packages multi-architecture container images."""

load("@rules_python//python:defs.bzl", "py_binary")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "workload_manifests")
load("//src/bazel/rules/oci:defs.bzl", "oci_multiarch_image", "oci_workload_publish", "oci_workload_run")

py_binary(
    name = "app",
    srcs = ["app.py"],
    deps = [
        "//src/infra/tools/otel_tracing/python",
    ],
)

oci_multiarch_image(
    name = "image",
    base = "ray_torch_base",
    binary = ":app",
)

workload_manifests(
    name = "manifest",
    srcs = [
        "deployment/kustomization.yaml",
        "deployment/project.yaml",
        "deployment/ray-serve.k8s.yaml",
    ],
)

oci_workload_publish(
    name = "publish",
    image = ":image",
)

oci_workload_run(
    name = "run",
    image = ":image",
    manifest = ":manifest",
    namespace = "team-examples-workloads",
)
