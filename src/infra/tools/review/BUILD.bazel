"""Builds the automated pull request review tool CLI binary and packages source code coverage targets."""

load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")

package_sources()

py_binary(
    name = "cli",
    srcs = ["cli.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/infra/tools/review/engine:github_comment",
        "//src/infra/tools/review/engine:runner",
    ],
)

sh_binary(
    name = "ci",
    srcs = ["ci.sh"],
    data = select({
        "@platforms//cpu:x86_64": ["@mise_linux_amd64//file"],
        "@platforms//cpu:aarch64": ["@mise_linux_arm64//file"],
        "//conditions:default": [],
    }) + [
        ":cli",
    ],
    visibility = ["//visibility:public"],
)
