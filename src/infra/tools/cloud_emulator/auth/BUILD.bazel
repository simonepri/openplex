# gazelle:resolve py infra.tools.cloud_emulator.auth.headscale_keys //src/infra/tools/cloud_emulator/auth:headscale_keys

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "eks_token",
    srcs = ["eks_token.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "eks_token_test",
    srcs = ["eks_token_test.py"],
    imports = [
        "../../..",
        "../../../..",
    ],
    deps = ["//src/infra/tools/cloud_emulator/auth:eks_token"],
)

py_library(
    name = "headscale_keys",
    srcs = ["headscale_keys.py"],
    imports = [
        "../../..",
        "../../../..",
    ],
    visibility = ["//visibility:public"],
    deps = ["//src/infra/tools/cloud_emulator:runtime"],
)

py_test(
    name = "headscale_keys_test",
    srcs = ["headscale_keys_test.py"],
    imports = [
        "../../..",
        "../../../..",
    ],
    deps = ["//src/infra/tools/cloud_emulator/auth:headscale_keys"],
)
