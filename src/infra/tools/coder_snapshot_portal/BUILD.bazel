"""Builds and packages the Coder snapshot portal container image and binaries."""

load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_go//go:def.bzl", "go_binary")
load("@rules_oci//oci:defs.bzl", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/oci:defs.bzl", "oci_multiarch_image", "oci_workload_publish")

# gazelle:exclude .

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

alias(
    name = "portal_lib",
    actual = "//src/infra/tools/coder_snapshot_portal/cmd/portal:portal_lib",
)

alias(
    name = "cmd/portal",
    actual = "//src/infra/tools/coder_snapshot_portal/cmd/portal:portal_lib",
)

go_binary(
    name = "coder_snapshot_portal",
    embed = ["//src/infra/tools/coder_snapshot_portal/cmd/portal:portal_lib"],
    pure = "on",
)

pkg_files(
    name = "binary_file",
    srcs = [":coder_snapshot_portal"],
    attributes = pkg_attributes(mode = "0555"),
    prefix = "/ko-app",
    renames = {"coder_snapshot_portal": "coder-snapshot-portal"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "binary_layer",
    srcs = [":binary_file"],
)

platform_transition_filegroup(
    name = "binary_layer_linux_amd64",
    srcs = [":binary_layer"],
    target_platform = ":linux_amd64",
)

platform_transition_filegroup(
    name = "binary_layer_linux_arm64",
    srcs = [":binary_layer"],
    target_platform = ":linux_arm64",
)

oci_multiarch_image(
    name = "image",
    arch_tars = {
        "amd64": [":binary_layer_linux_amd64"],
        "arm64": [":binary_layer_linux_arm64"],
    },
    base = "workspace_snapshot_catalog_base",
    entrypoint = ["/ko-app/coder-snapshot-portal"],
    staging_tag = "docker.io/cluster/coder-snapshot-portal:v0.1.0-r1",
    tars = [],
    user = "65532:65532",
)

oci_load(
    name = "preload",
    format = "oci",
    image = ":image_multiarch",
    repo_tags = ["docker.io/cluster/coder-snapshot-portal:v0.1.0-r1"],
    tags = ["manual"],
)

oci_workload_publish(
    name = "publish",
    image = ":image_multiarch",
    publication_mode = "digest",
    workload_name = "snapshot-portal",
)

filegroup(
    name = "preload_archive",
    srcs = [":preload"],
    output_group = "tarball",
)

package_sources()
