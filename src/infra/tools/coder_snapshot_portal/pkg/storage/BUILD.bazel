"""Builds storage backend implementations for workspace snapshot manifests."""

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "storage",
    srcs = [
        "memory.go",
        "s3.go",
        "storage.go",
    ],
    importpath = "go.invalid/internal/tools/coder_snapshot_portal/pkg/storage",
    visibility = ["//:__subpackages__"],
    deps = ["//src/infra/tools/coder_snapshot_portal/pkg/model"],
)

go_test(
    name = "storage_test",
    srcs = ["s3_test.go"],
    embed = [":storage"],
    deps = ["//src/infra/tools/coder_snapshot_portal/pkg/model"],
)
