"""Builds and tests the S3 URI resolver daemon and container image."""

load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/oci:defs.bzl", "oci_multiarch_image", "oci_workload_publish")

# gazelle:prefix go.invalid/internal/tools/s3_resolver/server

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "go.invalid/internal/tools/s3_resolver/server",
    visibility = ["//visibility:private"],
)

alias(
    name = "s3_resolver_lib",
    actual = ":server_lib",
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    pure = "on",
)

alias(
    name = "s3_resolver",
    actual = ":server",
)

go_test(
    name = "server_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":server_lib"],
)

alias(
    name = "s3_resolver_test",
    actual = ":server_test",
)

pkg_files(
    name = "binary_file",
    srcs = [":server"],
    attributes = pkg_attributes(mode = "0555"),
    prefix = "/ko-app",
    renames = {"server": "s3-resolver"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "binary_layer",
    srcs = [":binary_file"],
)

platform_transition_filegroup(
    name = "binary_layer_linux_amd64",
    srcs = [":binary_layer"],
    target_platform = ":linux_amd64",
)

platform_transition_filegroup(
    name = "binary_layer_linux_arm64",
    srcs = [":binary_layer"],
    target_platform = ":linux_arm64",
)

oci_multiarch_image(
    name = "image",
    arch_tars = {
        "amd64": [":binary_layer_linux_amd64"],
        "arm64": [":binary_layer_linux_arm64"],
    },
    base = "workspace_snapshot_catalog_base",
    entrypoint = ["/ko-app/s3-resolver"],
    tars = [],
    user = "65532:65532",
)

oci_workload_publish(
    name = "publish",
    image = ":image",
    publication_mode = "digest",
)

package_sources()
