"""Builds the Headscale workspace enrollment reverse proxy and OCI image."""

load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/oci:defs.bzl", "oci_workload_publish")

# gazelle:prefix go.invalid/internal/tools/headscale_workspace_enrollment

package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

go_library(
    name = "headscale_workspace_enrollment_lib",
    srcs = [
        "coder_authenticator.go",
        "lineage_claim.go",
        "main.go",
        "owner_binding.go",
        "preauth_key_lifecycle.go",
        "runtime_listener.go",
        "service_daemons.go",
        "snapshot_claim.go",
        "snapshot_principal.go",
        "workspace_agent_registration.go",
    ],
    importpath = "go.invalid/internal/tools/headscale_workspace_enrollment",
    visibility = ["//visibility:private"],
    deps = ["@com_github_coder_websocket//:websocket"],
)

go_binary(
    name = "headscale_workspace_enrollment",
    embed = [":headscale_workspace_enrollment_lib"],
    pure = "on",
)

go_test(
    name = "headscale_workspace_enrollment_test",
    srcs = [
        "lineage_claim_test.go",
        "main_test.go",
        "owner_binding_test.go",
        "preauth_key_lifecycle_test.go",
        "runtime_listener_test.go",
        "snapshot_claim_test.go",
        "workspace_agent_registration_test.go",
    ],
    embed = [":headscale_workspace_enrollment_lib"],
    deps = ["@com_github_coder_websocket//:websocket"],
)

pkg_files(
    name = "binary_file",
    srcs = [":headscale_workspace_enrollment"],
    attributes = pkg_attributes(mode = "0555"),
    prefix = "/ko-app",
    renames = {"headscale_workspace_enrollment": "headscale-workspace-enrollment"},
    strip_prefix = strip_prefix.files_only(),
)

pkg_tar(
    name = "binary_layer",
    srcs = [":binary_file"],
)

platform_transition_filegroup(
    name = "binary_layer_linux_amd64",
    srcs = [":binary_layer"],
    target_platform = ":linux_amd64",
)

platform_transition_filegroup(
    name = "binary_layer_linux_arm64",
    srcs = [":binary_layer"],
    target_platform = ":linux_arm64",
)

oci_image(
    name = "image_linux_amd64",
    base = "@headscale_base_linux_amd64",
    entrypoint = ["/ko-app/headscale-workspace-enrollment"],
    tars = [":binary_layer_linux_amd64"],
    user = "1000:1000",
)

oci_image(
    name = "image_linux_arm64",
    base = "@headscale_base_linux_arm64_v8",
    entrypoint = ["/ko-app/headscale-workspace-enrollment"],
    tars = [":binary_layer_linux_arm64"],
    user = "1000:1000",
)

oci_image_index(
    name = "image_multiarch",
    images = [
        ":image_linux_amd64",
        ":image_linux_arm64",
    ],
)

oci_load(
    name = "preload",
    format = "oci",
    image = ":image_multiarch",
    repo_tags = ["docker.io/infra/headscale-workspace-enrollment:v0.29.3-r6"],
    tags = ["manual"],
)

oci_push(
    name = "push",
    image = ":image_multiarch",
    tags = ["manual"],
)

oci_workload_publish(
    name = "publish",
    image = ":image_multiarch",
    publication_mode = "digest",
    workload_name = "headscale-workspace-enrollment",
)

filegroup(
    name = "preload_archive",
    srcs = [":preload"],
    output_group = "tarball",
)

package_sources()
