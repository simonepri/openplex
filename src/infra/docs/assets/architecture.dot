      "prowler" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/prowler.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Prowler</FONT></TD></TR></TABLE>>];
      "homer" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/homer.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Homer</FONT></TD></TR></TABLE>>];    }
