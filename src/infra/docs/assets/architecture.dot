      "developer-pod" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/coder.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Developer pod</FONT></TD></TR></TABLE>>];
