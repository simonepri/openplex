// Visualizes detailed system architecture, networking layers, and service boundaries.

digraph G {
  rankdir=TB; compound=true; newrank=true;
  graph [fontname="Helvetica", nodesep=0.35, ranksep=0.55];
  node  [fontname="Helvetica"];
  edge  [fontname="Helvetica", fontsize=7, color="#999999b3", arrowsize=0.5, labeldistance=2.2, labelangle=0];
  "people" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/person.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Devs</FONT></TD></TR></TABLE>>];
  subgraph cluster_laptop { label="Dev Laptop"; style="filled,rounded"; fillcolor="#F1F5F9"; color="#64748B"; fontsize=11; fontcolor="#334155";
    "tailnet" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/tailscale.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Tailscale client</FONT></TD></TR></TABLE>>];
    "browser" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/chrome.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">browser</FONT></TD></TR></TABLE>>];
    "terminal" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/terminal.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">SSH terminal</FONT></TD></TR></TABLE>>];
  }  "github" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/github.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">GitHub</FONT></TD></TR></TABLE>>];  subgraph cluster_every { label="Kubernetes fleet - every enrolled cluster"; style="filled,rounded"; fillcolor="#FAF8F5"; color="#9CA3AF"; fontsize=11; fontcolor="#4B5563";
    subgraph cluster_g_capacity { peripheries=0; label="";
      "karpenter" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/karpenter.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Karpenter</FONT></TD></TR></TABLE>>];
      "keda" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/keda.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">KEDA HPA</FONT></TD></TR></TABLE>>];
      "vpa" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/kubernetes.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">VPA</FONT></TD></TR></TABLE>>];
      "pvc-resizer" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/pvc.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">PVC Autoresizer</FONT></TD></TR></TABLE>>];
      "gpu-operator" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/nvidia.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">NVIDIA GPU</FONT></TD></TR></TABLE>>];
      "k8s-cleaner" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/k8s-cleaner.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">k8s-cleaner</FONT></TD></TR></TABLE>>];
    }
    subgraph cluster_g_security { peripheries=0; label="";
      "falco" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/falco.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Falco</FONT></TD></TR></TABLE>>];
      "kyverno" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/kyverno.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Kyverno</FONT></TD></TR></TABLE>>];
      "kubescape" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/kubescape.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Kubescape</FONT></TD></TR></TABLE>>];
      "trivy" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/trivy.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Trivy</FONT></TD></TR></TABLE>>];
    }
    subgraph cluster_g_database { peripheries=0; label="";
      "postgres" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/postgresql.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">PostgreSQL</FONT></TD></TR></TABLE>>];
      "valkey" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/valkey.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Valkey</FONT></TD></TR></TABLE>>];
    }
    subgraph cluster_g_backup { peripheries=0; label="";
      "velero" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/velero.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Velero</FONT></TD></TR></TABLE>>];
      "kopia" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/kopia.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Kopia</FONT></TD></TR></TABLE>>];
    }
    subgraph cluster_g_images { peripheries=0; label="";
      "estargz" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/containerd.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">eStargz</FONT></TD></TR></TABLE>>];
      "dragonfly" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/dragonfly.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Dragonfly</FONT></TD></TR></TABLE>>];
    }
    "otel" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/opentelemetry.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">OTel Collector</FONT></TD></TR></TABLE>>];
    "tsnet" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/tailscale.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Tailscale</FONT></TD></TR></TABLE>>];    "extsecrets" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/external-secrets.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">External Secrets</FONT></TD></TR></TABLE>>];    "workloads" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/kubernetes.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Pods on every cluster</FONT></TD></TR></TABLE>>];
    "pvc" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/pvc.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">PVC</FONT></TD></TR></TABLE>>];    subgraph cluster_ctrl { label="Controller Cluster - ctrl-<cloud>-<region>"; style="filled,rounded"; fillcolor="#F5F3FF"; color="#7C3AED"; fontsize=10; fontcolor="#5B21B6";
      "argocd" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/argocd.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Argo CD</FONT></TD></TR></TABLE>>];
      "coder" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/coder.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Coder</FONT></TD></TR></TABLE>>];
      subgraph cluster_g_infra { peripheries=0; label="";
        "atlantis" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/atlantis.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Atlantis</FONT></TD></TR></TABLE>>];
        "opentofu" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/opentofu.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">OpenTofu</FONT></TD></TR></TABLE>>];
      }      "kargo" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/kargo.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Kargo</FONT></TD></TR></TABLE>>];      "buildbuddy" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/buildbuddy.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">BuildBuddy</FONT></TD></TR></TABLE>>];      "obs-door" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/envoy.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Observability door</FONT></TD></TR></TABLE>>];      "headlamp" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/headlamp.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">Headlamp</FONT></TD></TR></TABLE>>];      "signoz" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/icons/signoz.svg" SCALE="TRUE"/></TD></TR><TR><TD><FONT POINT-SIZE="8">SigNoz</FONT></TD></TR></TABLE>>];      "parca" [shape=none, margin=0, label=<<TABLE BORDER="1" COLOR="#C9BFA6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDFBF4" STYLE="rounded"><TR><TD FIXEDSIZE="TRUE" WIDTH="34" HEIGHT="34"><IMG SRC="src/infra/docs/assets/i