"""Check targets for the Argo CD applications."""

load("@rules_python//python:defs.bzl", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")

source_set(
    name = "application_templates",
    srcs = glob(
        ["*.yaml"],
        exclude = ["profiles.yaml"],
    ),
    kind = HELM_TEMPLATE,
)

exports_files(
    [
        "cells.yaml",
        "ctrl.yaml",
    ],
    visibility = ["//visibility:public"],
)

# gazelle:python_extension disabled

package_sources(exclude = [
    "cells.yaml",
    "ctrl.yaml",
    "projects.yaml",
    "teams.yaml",
])

