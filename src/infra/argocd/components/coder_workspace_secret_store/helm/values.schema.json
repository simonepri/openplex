{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["auth", "authAdapter", "enabled", "namespace", "provider", "storeName"],
  "properties": {
    "enabled": { "type": "boolean" },
    "namespace": {
      "type": "string",
      "pattern": "^$|^team-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$|^coder-workspace-backup-system$"
    },
    "provider": { "enum": ["", "aws", "floci", "gcp"] },
    "authAdapter": { "enum": ["", "aws", "gcp", "kubernetes"] },
    "storeName": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^org-workspace-backups-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "auth": { "$ref": "#/definitions/auth" }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "auth": { "maxProperties": 0 },
          "authAdapter": { "const": "" },
          "namespace": { "const": "" },
          "provider": { "const": "" },
          "storeName": { "const": "" }
        }
      }
    },
    {
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "namespace": { "minLength": 1 },
          "provider": { "enum": ["aws", "floci", "gcp"] },
          "storeName": { "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "enabled": { "const": true }, "provider": { "const": "aws" } },
        "required": ["enabled", "provider"]
      },
      "then": { "properties": { "authAdapter": { "enum": ["", "aws"] } } }
    },
    {
      "if": {
        "properties": { "enabled": { "const": true }, "provider": { "const": "gcp" } },
        "required": ["enabled", "provider"]
      },
      "then": { "properties": { "authAdapter": { "enum": ["", "gcp"] } } }
    },
    {
      "if": {
        "properties": { "authAdapter": { "const": "aws" }, "enabled": { "const": true } },
        "required": ["authAdapter", "enabled"]
      },
      "then": { "properties": { "auth": { "required": ["aws"] } } }
    },
    {
      "if": {
        "properties": { "authAdapter": { "const": "gcp" }, "enabled": { "const": true } },
        "required": ["authAdapter", "enabled"]
      },
      "then": { "properties": { "auth": { "required": ["gcp"] } } }
    },
    {
      "if": {
        "properties": { "authAdapter": { "const": "kubernetes" }, "enabled": { "const": true } },
        "required": ["authAdapter", "enabled"]
      },
      "then": {
        "properties": {
          "auth": { "required": ["kubernetes"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authAdapter": { "const": "" },
          "enabled": { "const": true },
          "provider": { "const": "aws" }
        },
        "required": ["authAdapter", "enabled", "provider"]
      },
      "then": { "properties": { "auth": { "required": ["aws"] } } }
    },
    {
      "if": {
        "properties": {
          "authAdapter": { "const": "" },
          "enabled": { "const": true },
          "provider": { "const": "gcp" }
        },
        "required": ["authAdapter", "enabled", "provider"]
      },
      "then": { "properties": { "auth": { "required": ["gcp"] } } }
    },
    {
      "if": {
        "properties": { "enabled": { "const": true }, "provider": { "const": "floci" } },
        "required": ["enabled", "provider"]
      },
      "then": { "properties": { "authAdapter": { "enum": ["aws", "kubernetes"] } } }
    }
  ],
  "definitions": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region"],
          "properties": {
            "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$" }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clusterLocation", "clusterName", "projectId"],
          "properties": {
            "clusterLocation": { "type": "string", "minLength": 1 },
            "clusterName": { "type": "string", "minLength": 1 },
            "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" }
          }
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      },
      "minProperties": 0,
      "maxProperties": 1
    }
  }
}
