"""Check targets for the coder_workspace_secret_store Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

helm_chart(
    name = "chart",
    chart = "helm/Chart.yaml",
    schema = "helm/values.schema.json",
    templates = glob(
        ["helm/templates/**"],
        allow_empty = True,
    ),
    values = "helm/values.yaml",
)

helm_lint_test(
    name = "helm-lint-aws",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-aws.yaml"],
)

helm_template(
    name = "helm_render-aws",
    chart = ":chart",
    values = ["helm/lint-values-aws.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-aws",
    rendered = ":helm_render-aws",
)

helm_lint_test(
    name = "helm-lint-floci",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-floci.yaml"],
)

helm_template(
    name = "helm_render-floci",
    chart = ":chart",
    values = ["helm/lint-values-floci.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-floci",
    rendered = ":helm_render-floci",
)

helm_lint_test(
    name = "helm-lint-floci-aws",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-floci-aws.yaml"],
)

helm_template(
    name = "helm_render-floci-aws",
    chart = ":chart",
    values = ["helm/lint-values-floci-aws.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-floci-aws",
    rendered = ":helm_render-floci-aws",
)

helm_lint_test(
    name = "helm-lint-gcp",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-gcp.yaml"],
)

helm_template(
    name = "helm_render-gcp",
    chart = ":chart",
    values = ["helm/lint-values-gcp.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-gcp",
    rendered = ":helm_render-gcp",
)

source_set(
    name = "helm_templates",
    srcs = glob(["helm/templates/**"]),
    kind = HELM_TEMPLATE,
)

package_sources(exclude = ["helm/templates/**"])
