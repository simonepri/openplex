{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["authAdapter", "identity", "provider", "targetCell", "team", "topology"],
  "properties": {
    "team": { "type": "string", "maxLength": 58, "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
    "provider": { "enum": ["aws", "floci", "gcp"] },
    "authAdapter": { "enum": ["aws", "gcp", "kubernetes"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$" },
        "serviceAccount": { "type": "string" },
        "serviceAccountEmail": { "type": "string", "format": "email" }
      }
    },
    "targetCell": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^cell-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "topology": {
      "type": "object",
      "required": ["cells", "version"],
      "properties": {
        "version": { "const": 1 },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "virtualName"],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^cell-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
              },
              "virtualName": {
                "type": "string",
                "maxLength": 58,
                "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "provider": { "const": "aws" } } },
      "then": {
        "properties": {
          "authAdapter": { "const": "aws" },
          "identity": { "required": ["roleArn", "serviceAccount"] }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "gcp" } } },
      "then": {
        "properties": {
          "authAdapter": { "const": "gcp" },
          "identity": { "required": ["serviceAccount", "serviceAccountEmail"] }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "floci" } } },
      "then": {
        "properties": {
          "authAdapter": { "const": "kubernetes" },
          "identity": { "maxProperties": 0 }
        }
      }
    }
  ]
}
