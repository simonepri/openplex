{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "rayDashboard",
    "resources",
    "storageProjection",
    "team",
    "workloadImagePull",
    "workloadRepositories"
  ],
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "cell" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "workloadRepositories": { "minProperties": 1 },
          "team": {
            "properties": { "namespaceSuffix": { "minLength": 1 } }
          },
          "storageProjection": {
            "properties": {
              "handoff": {
                "properties": {
                  "secretStore": {
                    "properties": { "serviceAccount": { "const": "team-s3" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "storage-rbac" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "resources": { "maxItems": 0 },
          "workloadImagePull": {
            "properties": { "enabled": { "const": false } }
          },
          "workloadRepositories": { "maxProperties": 0 },
          "team": {
            "properties": { "namespaceSuffix": { "const": "" } }
          },
          "storageProjection": {
            "properties": {
              "enabled": { "const": true },
              "handoff": {
                "properties": {
                  "secretStore": {
                    "properties": { "serviceAccount": { "const": "team-s3" } }
                  }
                }
              },
              "rbacNamespaceSuffixes": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "mode": { "enum": ["cell", "storage-rbac"] },
    "workloadImagePull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "region", "roleArn"],
      "properties": {
        "enabled": { "type": "boolean" },
        "region": { "type": "string" },
        "roleArn": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "region": { "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]*$" },
              "roleArn": { "pattern": "^arn:[^:\\s]+:iam::[0-9]{12}:role/[^\\s]+$" }
            }
          },
          "else": {
            "properties": {
              "region": { "const": "" },
              "roleArn": { "const": "" }
            }
          }
        }
      ]
    },
    "workloadRepositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
      }
    },
    "rayDashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "group", "namespaceSuffix", "slug"],
      "properties": {
        "slug": {
          "type": "string",
          "maxLength": 31,
          "pattern": "^[a-z][a-z0-9]{1,30}$"
        },
        "group": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^$|^cluster:group:team:[a-z][a-z0-9]{1,30}$"
        },
        "namespaceSuffix": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$"
        },
        "classes": {
          "type": "array",
          "items": { "enum": ["be", "ha", "ma", "wa"] },
          "uniqueItems": true
        },
        "submitters": {
          "enum": ["all", "members"]
        }
      }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/definitions/resource" }
    },
    "storageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "rbacNamespaceSuffixes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "handoff": { "$ref": "#/definitions/storageProjectionHandoff" },
        "rbacNamespaceSuffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": { "required": ["handoff"] },
          "else": { "not": { "required": ["handoff"] } }
        }
      ]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ephemeralStorage": { "type": "string" }
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ephemeralStorage": { "type": "string" },
                "storage": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "apiGroup", "kind", "project", "resource"],
      "properties": {
        "access": { "enum": ["edit", "view"] },
        "apiGroup": { "type": "string" },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "project": { "type": "boolean" },
        "resource": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "storageProjectionHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalSecret", "provider", "recordName"],
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "aws" } }, "required": ["provider"] },
          "then": {
            "properties": { "secretStore": { "properties": { "auth": { "required": ["aws"] } } } }
          }
        },
        {
          "if": { "properties": { "provider": { "const": "gcp" } }, "required": ["provider"] },
          "then": {
            "required": ["secretStore"],
            "properties": { "secretStore": { "properties": { "auth": { "required": ["gcp"] } } } }
          }
        },
        {
          "if": { "properties": { "provider": { "const": "floci" } }, "required": ["provider"] },
          "then": {
            "required": ["secretStore"],
            "properties": {
              "secretStore": {
                "properties": {
                  "auth": {
                    "anyOf": [{ "required": ["kubernetes"] }, { "required": ["aws"] }]
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "provider": { "enum": ["aws", "floci", "gcp"] },
        "recordName": { "type": "string", "minLength": 1 },
        "secretStore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auth", "name", "serviceAccount"],
          "properties": {
            "name": { "const": "team-s3" },
            "serviceAccount": { "enum": ["team-s3", "workflow"] },
            "auth": { "$ref": "#/definitions/storageProjectionAuth" }
          }
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "remoteProperties", "targetSecretName"],
          "properties": {
            "name": { "const": "team-s3" },
            "targetSecretName": { "const": "team-s3" },
            "remoteProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accessKeyId", "secretAccessKey"],
              "properties": {
                "accessKeyId": { "type": "string", "minLength": 1 },
                "globalAccessKeyId": { "type": "string", "minLength": 1 },
                "globalBucket": { "type": "string", "minLength": 1 },
                "globalEndpoint": { "type": "string", "minLength": 1 },
                "globalSecretAccessKey": { "type": "string", "minLength": 1 },
                "secretAccessKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "storageContract": { "$ref": "#/definitions/teamStorageContract" }
      }
    },
    "teamStorageContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationPrefixes", "gateway", "mounts", "version"],
      "properties": {
        "version": { "const": 1 },
        "authorizationPrefixes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "global-meta", "global-scratch", "home", "meta", "scratch"],
          "properties": {
            "global": {
              "type": "string",
              "pattern": "^global/home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$"
            },
            "global-meta": { "type": "string", "pattern": "^global/meta/$" },
            "global-scratch": {
              "type": "string",
              "pattern": "^global/scratch/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$"
            },
            "home": { "type": "string", "pattern": "^home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$" },
            "meta": { "type": "string", "pattern": "^meta/$" },
            "scratch": { "type": "string", "pattern": "^scratch/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$" }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint"],
          "properties": {
            "endpoint": { "const": "http://s3-gateway.s3-system.svc" }
          }
        },
        "mounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "global-meta", "global-scratch", "home", "meta", "scratch"],
          "properties": {
            "global": { "$ref": "#/definitions/teamStorageMountGlobal" },
            "global-meta": { "$ref": "#/definitions/teamStorageMountGlobalMeta" },
            "global-scratch": { "$ref": "#/definitions/teamStorageMountGlobalScratch" },
            "home": { "$ref": "#/definitions/teamStorageMountHome" },
            "meta": { "$ref": "#/definitions/teamStorageMountMeta" },
            "scratch": { "$ref": "#/definitions/teamStorageMountScratch" }
          }
        }
      }
    },
    "teamStorageMountGlobal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "const": "global" },
        "keyPrefix": {
          "type": "string",
          "pattern": "^home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/(?:[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/)?$"
        },
        "remote": { "const": "global" }
      }
    },
    "teamStorageMountGlobalMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "const": "global" },
        "keyPrefix": { "const": "meta/" },
        "remote": { "const": "global-meta" }
      }
    },
    "teamStorageMountGlobalScratch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "const": "global" },
        "keyPrefix": {
          "type": "string",
          "pattern": "^scratch/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$"
        },
        "remote": { "const": "global-scratch" }
      }
    },
    "teamStorageMountHome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
        "keyPrefix": { "type": "string", "pattern": "^home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$" },
        "remote": { "const": "home" }
      }
    },
    "teamStorageMountMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
        "keyPrefix": { "const": "meta/" },
        "remote": { "const": "meta" }
      }
    },
    "teamStorageMountScratch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
        "keyPrefix": { "type": "string", "pattern": "^scratch/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$" },
        "remote": { "const": "scratch" }
      }
    },
    "storageProjectionAuth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["aws"],
          "properties": {
            "aws": {
              "type": "object",
              "additionalProperties": false,
              "required": ["region"],
              "properties": {
                "region": { "type": "string", "pattern": "^(?:[a-z]{2}-[a-z]+-[0-9]+|lh[0-9]+)$" },
                "roleArn": {
                  "type": "string",
                  "pattern": "^$|^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gcp"],
          "properties": {
            "gcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clusterLocation", "clusterName", "projectId", "serviceAccountEmail"],
              "properties": {
                "clusterLocation": { "type": "string", "minLength": 1 },
                "clusterName": { "type": "string", "minLength": 1 },
                "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
                "serviceAccountEmail": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kubernetes"],
          "properties": {
            "kubernetes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["remoteNamespace"],
              "properties": {
                "remoteNamespace": { "const": "secret-records" }
              }
            }
          }
        }
      ]
    }
  }
}
