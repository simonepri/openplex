{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "devSecrets",
    "devWorkspaces",
    "mode",
    "rayDashboard",
    "resources",
    "runtimeSecrets",
    "storageProjection",
    "team",
    "workloadImagePull",
    "workloadRepositories",
    "workspaceSubmissions"
  ],
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "cell" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "workloadRepositories": { "minProperties": 1 },
          "team": {
            "properties": { "namespaceSuffix": { "minLength": 1 } }
          },
          "storageProjection": {
            "properties": {
              "handoff": {
                "properties": {
                  "secretStore": {
                    "properties": { "serviceAccount": { "const": "team-s3" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "storage-rbac" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "devSecrets": {
            "properties": { "names": { "maxItems": 0 } }
          },
          "devWorkspaces": {
            "properties": { "enabled": { "const": false } }
          },
          "resources": { "maxItems": 0 },
          "workloadImagePull": {
            "properties": { "enabled": { "const": false } }
          },
          "workloadRepositories": { "maxProperties": 0 },
          "team": {
            "properties": { "namespaceSuffix": { "const": "" } }
          },
          "storageProjection": {
            "properties": {
              "enabled": { "const": true },
              "handoff": {
                "properties": {
                  "secretStore": {
                    "properties": { "serviceAccount": { "const": "team-s3" } }
                  }
                }
              },
              "rbacNamespaceSuffixes": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "devWorkspaces": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          }
        },
        "required": ["devWorkspaces"]
      },
      "then": {
        "properties": {
          "storageProjection": {
            "properties": {
              "handoff": { "required": ["storageContract"] }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "mode": { "enum": ["cell", "storage-rbac"] },
    "workloadImagePull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "region", "roleArn"],
      "properties": {
        "enabled": { "type": "boolean" },
        "region": { "type": "string" },
        "roleArn": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "region": { "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[1-9][0-9]*$" },
              "roleArn": { "pattern": "^arn:[^:\\s]+:iam::[0-9]{12}:role/[^\\s]+$" }
            }
          },
          "else": {
            "properties": {
              "region": { "const": "" },
              "roleArn": { "const": "" }
            }
          }
        }
      ]
    },
    "workloadRepositories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
      }
    },
    "workspaceSubmissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceNamespace"],
      "properties": {
        "sourceNamespace": {
          "type": "string",
          "pattern": "^$|^team-[a-z][a-z0-9]{1,30}-workspaces$"
        }
      }
    },
    "rayDashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "devWorkspaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "localGitCIDR", "originRegistryCIDR"],
      "properties": {
        "buildbuddy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessAliasDomain"],
          "properties": {
            "accessAliasDomain": {
              "type": "string",
              "pattern": "^(?:c|k8s)\\.[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
              "not": { "pattern": "\\.localhost$" }
            },
            "enterpriseProxy": { "type": "boolean" },
            "executors": { "enum": ["none", "cpu", "gpu", "all"] },
            "mode": { "enum": ["cloud", "community"] }
          }
        },
        "buildbuddyAuth": { "$ref": "#/definitions/buildbuddyAuth" },
        "cell": { "type": "string", "pattern": "^cell-[a-z0-9-]+$" },
        "enabled": { "type": "boolean" },
        "localGitCIDR": {
          "type": "string",
          "pattern": "^$|^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
        },
        "originRegistryCIDR": {
          "type": "string",
          "pattern": "^$|^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authMode",
            "kubernetesApiCIDRs",
            "privateHttpsCIDRs",
            "provider",
            "publicHttps",
            "region",
            "registry",
            "roleArn",
            "tokenAudience",
            "tokenFile"
          ],
          "properties": {
            "authMode": { "enum": ["eks-pod-identity", "floci", "web-identity"] },
            "kubernetesApiCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/32$"
              },
              "uniqueItems": true
            },
            "privateHttpsCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/32$"
              },
              "uniqueItems": true
            },
            "provider": { "enum": ["aws", "floci", "gcp"] },
            "publicHttps": { "type": "boolean" },
            "region": { "type": "string", "minLength": 1 },
            "registry": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[1-9][0-9]{0,4})?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)*$"
            },
            "roleArn": { "type": "string" },
            "tokenAudience": { "type": "string" },
            "tokenFile": { "type": "string" }
          },
          "oneOf": [
            {
              "properties": {
                "authMode": { "const": "floci" },
                "kubernetesApiCIDRs": { "minItems": 1 },
                "privateHttpsCIDRs": { "maxItems": 0 },
                "provider": { "const": "floci" },
                "publicHttps": { "const": true },
                "registry": {
                  "pattern": "^origin-registry:5000/[0-9]{12}/[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$"
                },
                "roleArn": { "const": "" },
                "tokenAudience": { "const": "" },
                "tokenFile": { "const": "" }
              }
            },
            {
              "properties": {
                "authMode": { "const": "eks-pod-identity" },
                "kubernetesApiCIDRs": { "minItems": 1 },
                "privateHttpsCIDRs": { "minItems": 1 },
                "provider": { "const": "aws" },
                "publicHttps": { "const": true },
                "registry": {
                  "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+\\.amazonaws\\.com$"
                },
                "roleArn": {
                  "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_-]{1,64}$"
                },
                "tokenAudience": { "const": "" },
                "tokenFile": { "const": "" }
              }
            },
            {
              "properties": {
                "authMode": { "const": "web-identity" },
                "kubernetesApiCIDRs": { "minItems": 1 },
                "privateHttpsCIDRs": { "maxItems": 0 },
                "provider": { "const": "gcp" },
                "publicHttps": { "const": true },
                "registry": {
                  "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+\\.amazonaws\\.com$"
                },
                "roleArn": {
                  "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_-]{1,64}$"
                },
                "tokenAudience": { "const": "sts.amazonaws.com" },
                "tokenFile": { "const": "/var/run/secrets/workload-origin/token" }
              }
            }
          ]
        },
        "recordName": { "type": "string", "minLength": 1 },
        "provisionerSubject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiGroup", "kind", "name"],
          "properties": {
            "apiGroup": { "const": "rbac.authorization.k8s.io" },
            "kind": { "enum": ["Group", "User"] },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "secretStoreName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^org-workspace-backups-team-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "required": [
              "buildbuddy",
              "buildbuddyAuth",
              "cell",
              "origin",
              "provisionerSubject",
              "recordName",
              "secretStoreName"
            ],
            "allOf": [
              {
                "if": {
                  "properties": { "origin": { "properties": { "authMode": { "const": "floci" } } } }
                },
                "then": {
                  "properties": {
                    "originRegistryCIDR": { "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$" }
                  }
                },
                "else": {
                  "properties": { "originRegistryCIDR": { "const": "" } }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "originRegistryCIDR": { "const": "" }
            },
            "not": {
              "anyOf": [
                { "required": ["buildbuddy"] },
                { "required": ["buildbuddyAuth"] },
                { "required": ["cell"] },
                { "required": ["origin"] },
                { "required": ["provisionerSubject"] },
                { "required": ["recordName"] },
                { "required": ["secretStoreName"] }
              ]
            }
          }
        }
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "group", "namespaceSuffix", "slug"],
      "properties": {
        "slug": {
          "type": "string",
          "maxLength": 31,
          "pattern": "^[a-z][a-z0-9]{1,30}$"
        },
        "group": {
          "type": "string",
          "maxLength": 50,
          "pattern": "^$|^cluster:group:team:[a-z][a-z0-9]{1,30}$"
        },
        "namespaceSuffix": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$"
        },
        "classes": {
          "type": "array",
          "items": { "enum": ["be", "ha", "ma", "wa"] },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "email": { "type": "string", "format": "email" },
              "roles": {
                "type": "array",
                "items": { "enum": ["dev", "ops"] },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["id", "email", "roles"],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "dev": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "ops": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/definitions/resource" }
    },
    "devSecrets": { "$ref": "#/definitions/devSecrets" },
    "runtimeSecrets": { "$ref": "#/definitions/runtimeSecrets" },
    "storageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "rbacNamespaceSuffixes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "handoff": { "$ref": "#/definitions/storageProjectionHandoff" },
        "rbacNamespaceSuffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": { "required": ["handoff"] },
          "else": { "not": { "required": ["handoff"] } }
        }
      ]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ephemeralStorage": { "type": "string" }
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ephemeralStorage": { "type": "string" },
                "storage": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "buildbuddyAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "auth", "recordName"],
      "properties": {
        "adapter": { "enum": ["aws", "gcp", "kubernetes"] },
        "auth": { "$ref": "#/definitions/runtimeSecretsAuth" },
        "recordName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^buildbuddy-auth-cell-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "aws" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "required": ["aws"] } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "gcp" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "required": ["gcp"] } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "kubernetes" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "required": ["kubernetes"] } } }
        }
      ]
    },
    "devSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names"],
      "properties": {
        "names": {
          "type": "array",
          "items": { "$ref": "#/definitions/devSecretName" },
          "uniqueItems": true
        }
      }
    },
    "devSecretName": {
      "type": "string",
      "maxLength": 81,
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "apiGroup", "kind", "project", "resource"],
      "properties": {
        "access": { "enum": ["edit", "view"] },
        "apiGroup": { "type": "string" },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "project": { "type": "boolean" },
        "resource": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "runtimeSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "auth"],
      "properties": {
        "adapter": { "enum": ["", "aws", "gcp", "kubernetes"] },
        "auth": { "$ref": "#/definitions/runtimeSecretsAuth" }
      },
      "allOf": [
        {
          "if": { "properties": { "adapter": { "const": "" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "maxProperties": 0 } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "aws" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "required": ["aws"] } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "gcp" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "required": ["gcp"] } } }
        },
        {
          "if": { "properties": { "adapter": { "const": "kubernetes" } }, "required": ["adapter"] },
          "then": { "properties": { "auth": { "required": ["kubernetes"] } } }
        }
      ]
    },
    "runtimeSecretsAuth": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 0,
      "maxProperties": 1,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region"],
          "properties": {
            "region": { "type": "string", "pattern": "^(?:[a-z]{2}-[a-z]+-[0-9]+|lh[0-9]+)$" },
            "endpoint": { "type": "string" }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId"],
          "properties": {
            "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" }
          }
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "storageProjectionHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalSecret", "provider", "recordName", "secretStore"],
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "aws" } }, "required": ["provider"] },
          "then": {
            "properties": { "secretStore": { "properties": { "auth": { "required": ["aws"] } } } }
          }
        },
        {
          "if": { "properties": { "provider": { "const": "gcp" } }, "required": ["provider"] },
          "then": {
            "properties": { "secretStore": { "properties": { "auth": { "required": ["gcp"] } } } }
          }
        },
        {
          "if": { "properties": { "provider": { "const": "floci" } }, "required": ["provider"] },
          "then": {
            "properties": {
              "secretStore": {
                "properties": {
                  "auth": {
                    "anyOf": [{ "required": ["kubernetes"] }, { "required": ["aws"] }]
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "provider": { "enum": ["aws", "floci", "gcp"] },
        "recordName": { "type": "string", "minLength": 1 },
        "secretStore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auth", "name", "serviceAccount"],
          "properties": {
            "name": { "const": "team-s3" },
            "serviceAccount": { "enum": ["team-s3", "workflow"] },
            "auth": { "$ref": "#/definitions/storageProjectionAuth" }
          }
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "remoteProperties", "targetSecretName"],
          "properties": {
            "name": { "const": "team-s3" },
            "targetSecretName": { "const": "team-s3" },
            "remoteProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accessKeyId", "secretAccessKey"],
              "properties": {
                "accessKeyId": { "type": "string", "minLength": 1 },
                "secretAccessKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "storageContract": { "$ref": "#/definitions/teamStorageContract" }
      }
    },
    "teamStorageContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationPrefixes", "gateway", "mounts", "version"],
      "properties": {
        "version": { "const": 1 },
        "authorizationPrefixes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "global-meta", "global-scratch", "home", "meta", "scratch"],
          "properties": {
            "global": {
              "type": "string",
              "pattern": "^global/home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$"
            },
            "global-meta": { "type": "string", "pattern": "^global/meta/$" },
            "global-scratch": {
              "type": "string",
              "pattern": "^global/scratch/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$"
            },
            "home": { "type": "string", "pattern": "^home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$" },
            "meta": { "type": "string", "pattern": "^meta/$" },
            "scratch": { "type": "string", "pattern": "^scratch/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$" }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint"],
          "properties": {
            "endpoint": { "const": "http://s3-gateway.s3-system.svc" }
          }
        },
        "mounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["global", "global-meta", "global-scratch", "home", "meta", "scratch"],
          "properties": {
            "global": { "$ref": "#/definitions/teamStorageMountGlobal" },
            "global-meta": { "$ref": "#/definitions/teamStorageMountGlobalMeta" },
            "global-scratch": { "$ref": "#/definitions/teamStorageMountGlobalScratch" },
            "home": { "$ref": "#/definitions/teamStorageMountHome" },
            "meta": { "$ref": "#/definitions/teamStorageMountMeta" },
            "scratch": { "$ref": "#/definitions/teamStorageMountScratch" }
          }
        }
      }
    },
    "teamStorageMountGlobal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "const": "global" },
        "keyPrefix": {
          "type": "string",
          "pattern": "^home/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/[a-z0-9](?:[-a-z0-9]*[a-z0-9])?/$"
        },
        "remote": { "const": "global" }
      }
    },
    "teamStorageMountGlobalMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "keyPrefix", "remote"],
      "properties": {
        "bucket": { "const": "global" },
