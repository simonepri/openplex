"""Defines build and check targets for the team_namespace Argo CD component."""

# gazelle:resolve py yaml @dev_python_deps//pyyaml

load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template")
load("@rules_python//python:defs.bzl", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

helm_chart(
    name = "chart",
    chart = "helm/Chart.yaml",
    schema = "helm/values.schema.json",
    templates = glob(
        ["helm/templates/**"],
        allow_empty = True,
    ),
    values = "helm/values.yaml",
)

helm_lint_test(
    name = "helm-lint-floci",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-floci.yaml"],
)

helm_template(
    name = "helm_render-floci",
    chart = ":chart",
    values = ["helm/lint-values-floci.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-floci",
    rendered = ":helm_render-floci",
)

helm_lint_test(
    name = "helm-lint-gcp",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-gcp.yaml"],
)

helm_template(
    name = "helm_render-gcp",
    chart = ":chart",
    values = ["helm/lint-values-gcp.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-gcp",
    rendered = ":helm_render-gcp",
)

helm_lint_test(
    name = "helm-lint-storage-rbac",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-storage-rbac.yaml"],
)

helm_template(
    name = "helm_render-storage-rbac",
    chart = ":chart",
    values = ["helm/lint-values-storage-rbac.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-storage-rbac",
    rendered = ":helm_render-storage-rbac",
)

helm_lint_test(
    name = "helm-lint",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values.yaml"],
)

helm_template(
    name = "helm_render",
    chart = ":chart",
    values = ["helm/lint-values.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm",
    rendered = ":helm_render",
)

py_test(
    name = "team_namespace_test",
    srcs = ["team_namespace_test.py"],
    args = [
        "$(locations @rules_helm//helm:current_toolchain)",
        "$(location helm/Chart.yaml)",
    ],
    data = [
        "helm/Chart.yaml",
        "helm/lint-values.yaml",
        "helm/lint-values-floci.yaml",
        "helm/lint-values-gcp.yaml",
        "helm/lint-values-storage-rbac.yaml",
        "helm/values.schema.json",
        "helm/values.yaml",
        ":chart",
        ":helm_render",
        "@rules_helm//helm:current_toolchain",
    ],
    deps = ["@dev_python_deps//pyyaml"],  # keep
)

source_set(
    name = "helm_templates",
    srcs = glob(["helm/templates/**"]),
    kind = HELM_TEMPLATE,
)

package_sources(exclude = [
    "helm/templates/**",
    "**/*.py",
])
