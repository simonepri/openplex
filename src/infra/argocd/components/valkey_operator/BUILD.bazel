"""Defines build and check targets for the valkey_operator Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_template")
load("@rules_kustomize//kustomize:kustomize.bzl", "kustomization", "kustomized_resources")
load("@rules_python//python:defs.bzl", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

kustomization(
    name = "base",
    srcs = glob(["kustomize/**"]),
    file = "kustomize/kustomization.yaml",
)

kustomized_resources(
    name = "base_render",
    kustomization = ":base",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "base_manifest",
    rendered = ":base_render",
)

helm_template(
    name = "vendor-helm-render",
    chart = "@vendor_helm_valkey_operator//:valkey-operator",
    opts = [
        "--include-crds",
        "--namespace",
        "manifest-checks",
    ],
    values = [
        "helm/values.yaml",
    ],
)

package_sources(exclude = ["**/*.py"])

manifest_checks(
    name = "vendor-helm",
    kube_lint_config = "//src/bazel/rules/kubernetes_manifests:kube-linter-vendor.yaml",
    rendered = ":vendor-helm-render",
)

py_test(
    name = "cache_scheduling_test",
    srcs = ["cache_scheduling_test.py"],
    args = [
        "$(location :base_render)",
        "$(location //src/infra/argocd/components/torch_compile_cache:base_render)",
    ],
    data = [
        ":base_render",
        "//src/infra/argocd/components/torch_compile_cache:base_render",
    ],
    deps = ["@dev_python_deps//pyyaml"],
)
