{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "mode",
    "originRepositories",
    "promotionMode",
    "repositoryURL",
    "stage",
    "teamSlug",
    "warehouses"
  ],
  "properties": {
    "mode": { "type": "string", "enum": ["disabled", "stage", "warehouse"] },
    "promotionMode": { "type": "string", "const": "automatic" },
    "teamSlug": {
      "type": "string",
      "maxLength": 58,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "repositoryURL": { "type": "string" },
    "originRepositories": { "$ref": "#/definitions/repositoryMap" },
    "images": { "type": "array", "items": { "$ref": "#/definitions/image" } },
    "warehouses": { "type": "array", "items": { "$ref": "#/definitions/warehouse" } },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationName": { "$ref": "#/definitions/dnsSubdomain" },
        "automatic": { "type": "boolean" },
        "deploymentRepositories": { "$ref": "#/definitions/repositoryMap" },
        "name": { "$ref": "#/definitions/dnsLabel" },
        "source": { "$ref": "#/definitions/stageSource" },
        "warehouseName": { "$ref": "#/definitions/dnsLabel" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "enum": ["stage", "warehouse"] } } },
      "then": {
        "properties": {
          "originRepositories": { "minProperties": 1 },
          "repositoryURL": {
            "type": "string",
            "pattern": "^(https://[^\\s]+|git://(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])|192\\.168)\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]):9418/[a-z0-9][a-z0-9._-]*\\.git|http://(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])|192\\.168)\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]):9419/cgi-bin/git/[a-z0-9][a-z0-9._-]*\\.git)$"
          },
          "teamSlug": { "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "warehouse" } } },
      "then": {
        "properties": {
          "images": { "maxItems": 0 },
          "stage": { "maxProperties": 0 },
          "warehouses": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "stage" } } },
      "then": {
        "properties": {
          "images": { "minItems": 1 },
          "stage": {
            "required": [
              "applicationName",
              "automatic",
              "deploymentRepositories",
              "name",
              "source",
              "warehouseName"
            ]
          },
          "warehouses": { "maxItems": 0 }
        }
      }
    }
  ],
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(?:/[a-z0-9._-]+)*$"
    },
    "repositoryMap": {
      "type": "object",
      "propertyNames": { "pattern": "^src/[a-z0-9_/-]+$" },
      "additionalProperties": { "$ref": "#/definitions/repository" }
    },
    "stageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["stage", "warehouse"] },
        "name": { "$ref": "#/definitions/dnsLabel" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "stage" } }, "required": ["kind"] },
          "then": { "required": ["name"] },
          "else": { "not": { "required": ["name"] } }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestRepository", "package", "repository", "sourceName", "target"],
      "properties": {
        "manifestRepository": { "$ref": "#/definitions/repository" },
        "package": { "type": "string", "pattern": "^src/[a-z0-9_/-]+$" },
        "repository": { "type": "string", "pattern": "^src/[a-z0-9_/-]+$" },
        "sourceName": { "$ref": "#/definitions/dnsLabel" },
        "target": { "type": "string", "pattern": "^//src/[a-z0-9_/-]+:image_push$" }
      }
    },
    "warehouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "name"],
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/image" }
        },
        "name": { "$ref": "#/definitions/dnsLabel" }
      }
    }
  }
}
