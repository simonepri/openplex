"""Check targets for the kargo_promotion Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template")
load("@rules_python//python:defs.bzl", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

helm_chart(
    name = "chart",
    chart = "helm/Chart.yaml",
    schema = "helm/values.schema.json",
    templates = glob(
        ["helm/templates/**"],
        allow_empty = True,
    ),
    values = "helm/values.yaml",
)

helm_lint_test(
    name = "helm-lint-stage-direct",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-stage-direct.yaml"],
)

helm_template(
    name = "helm_render-stage-direct",
    chart = ":chart",
    values = ["helm/lint-values-stage-direct.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-stage-direct",
    rendered = ":helm_render-stage-direct",
)

helm_lint_test(
    name = "helm-lint-stage",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-stage.yaml"],
)

helm_template(
    name = "helm_render-stage",
    chart = ":chart",
    values = ["helm/lint-values-stage.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-stage",
    rendered = ":helm_render-stage",
)

helm_lint_test(
    name = "helm-lint",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values.yaml"],
)

helm_template(
    name = "helm_render",
    chart = ":chart",
    values = ["helm/lint-values.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm",
    rendered = ":helm_render",
)

source_set(
    name = "helm_templates",
    srcs = glob(["helm/templates/**"]),
    kind = HELM_TEMPLATE,
)

py_test(
    name = "values_schema_test",
    srcs = ["values_schema_test.py"],
    data = ["helm/values.schema.json"],
)

package_sources(exclude = [
    "helm/templates/**",
    "**/*.py",
])
