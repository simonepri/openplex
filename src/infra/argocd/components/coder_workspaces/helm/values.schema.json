{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accessAliasDomain",
    "buildbuddy",
    "cell",
    "gcpProjectId",
    "localGitCIDR",
    "origin",
    "provider",
    "provisionerSubject",
    "region"
  ],
  "properties": {
    "cell": {
      "type": "string",
      "pattern": "^cell-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$",
      "maxLength": 48
    },
    "provider": { "enum": ["aws", "floci", "gcp"] },
    "region": { "type": "string", "pattern": "^[a-z]+(?:-[a-z0-9]+)+$" },
    "gcpProjectId": { "type": "string", "pattern": "^$|^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
    "accessAliasDomain": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)+$"
    },
    "buildbuddy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterpriseProxy", "executors", "mode"],
      "properties": {
        "mode": { "enum": ["cloud", "community"] },
        "enterpriseProxy": { "type": "boolean" },
        "executors": { "enum": ["all", "cpu", "gpu", "none"] }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kubernetesApiCIDRs",
        "privateHttpsCIDRs",
        "region",
        "registry",
        "registryCIDR",
        "roleArn"
      ],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$" },
        "roleArn": {
          "type": "string",
          "pattern": "^$|^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_-]{1,64}$"
        },
        "privateHttpsCIDRs": { "$ref": "#/definitions/hostCIDRs" },
        "kubernetesApiCIDRs": { "$ref": "#/definitions/hostCIDRs" },
        "registryCIDR": {
          "type": "string",
          "pattern": "^$|^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/32$"
        }
      }
    },
    "localGitCIDR": {
      "type": "string",
      "pattern": "^$|^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/32$"
    },
    "provisionerSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiGroup", "kind", "name"],
      "properties": {
        "apiGroup": { "const": "rbac.authorization.k8s.io" },
        "kind": { "enum": ["Group", "User"] },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provider": { "const": "aws" } },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "gcpProjectId": { "const": "" },
          "localGitCIDR": { "const": "" },
          "region": { "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$" },
          "provisionerSubject": {
            "properties": {
              "kind": { "const": "Group" },
              "name": { "const": "cluster:coder-provisioners" }
            }
          },
          "origin": {
            "properties": {
              "registry": {
                "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+\\.amazonaws\\.com$"
              },
              "roleArn": { "minLength": 1 },
              "registryCIDR": { "const": "" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "gcp" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "gcpProjectId": { "minLength": 1 },
          "localGitCIDR": { "const": "" },
          "region": { "minLength": 1 },
          "provisionerSubject": {
            "properties": {
              "kind": { "const": "User" },
              "name": {
                "pattern": "^coder-provisioner@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
              }
            }
          },
          "origin": {
            "properties": {
              "registry": {
                "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+\\.amazonaws\\.com$"
              },
              "roleArn": { "minLength": 1 },
              "privateHttpsCIDRs": { "maxItems": 0 },
              "registryCIDR": { "const": "" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "provider": { "const": "floci" } }, "required": ["provider"] },
      "then": {
        "properties": {
          "gcpProjectId": { "const": "" },
          "region": { "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$" },
          "provisionerSubject": {
            "properties": {
              "kind": { "const": "Group" },
              "name": { "const": "cluster:coder-provisioners" }
            }
          },
          "origin": {
            "properties": {
              "registry": {
                "pattern": "^origin-registry:5000/[0-9]{12}/[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$"
              },
              "roleArn": { "const": "" },
              "privateHttpsCIDRs": { "maxItems": 0 },
              "registryCIDR": { "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "hostCIDRs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})/32$"
      }
    }
  }
}
