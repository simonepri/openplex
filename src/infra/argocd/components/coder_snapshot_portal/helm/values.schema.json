{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["access", "cell", "certificate", "coder", "image", "s3"],
  "properties": {
    "cell": { "type": "string", "pattern": "^(?:cell|ctrl)-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "privateEgress"],
      "properties": {
        "accessDomain": {
          "type": "string"
        },
        "aliasDomain": {
          "type": "string"
        },
        "gatewayIPv4": {
          "type": "string",
          "format": "ipv4"
        },
        "hostname": {
          "type": "string",
          "pattern": "^coder-snapshots\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
        },
        "privateEgress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "podLabels", "port"],
          "properties": {
            "namespace": { "const": "tailscale-system" },
            "podLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "coder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "url"],
      "properties": {
        "template": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
        "url": {
          "type": "string",
          "pattern": "^https?://coder\\.[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?(?::[0-9]+)?$"
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buckets", "endpoint", "region"],
      "properties": {
        "buckets": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "endpoint": { "type": "string" },
        "region": { "type": "string" }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerName"],
      "properties": {
        "issuerName": { "enum": ["cluster-local-ca", "public-acme"] }
      }
    },
    "localCA": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "configMapName": { "type": "string" }
      }
    },
    "image": { "$ref": "#/definitions/image" },
    "resources": { "$ref": "#/definitions/resources" },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSecretEnabled": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pullPolicy", "repository"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(?:placeholder\\.invalid/src/infra/tools/coder_snapshot_portal|localhost:15100/000000000000/us-east-1/src/infra/tools/coder_snapshot_portal|[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/.+)$"
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "type": "object" },
        "requests": { "type": "object" }
      }
    }
  }
}
