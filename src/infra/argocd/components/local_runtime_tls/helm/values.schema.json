{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["accessAliasDomain", "endpointRegions", "internalDomain", "local", "publicDomain"],
  "properties": {
    "accessAliasDomain": { "type": "string", "minLength": 1 },
    "internalDomain": { "type": "string", "minLength": 1 },
    "publicDomain": { "type": "string", "minLength": 1 },
    "endpointRegions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecr", "s3"],
      "properties": {
        "ecr": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "s3": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "clusters": {
      "type": "object",
      "description": "Canonical registry records validated by the fleet schema."
    },
    "local": {
      "type": "object",
      "description": "Canonical local registry configuration validated by the fleet schema.",
      "required": ["control", "network"],
      "properties": {
        "control": {
          "type": "object",
          "required": ["record"],
          "properties": { "record": { "type": "string", "minLength": 1 } }
        },
        "network": {
          "type": "object",
          "required": ["services"],
          "properties": {
            "services": {
              "type": "object",
              "required": ["floci", "headscale", "origin_registry"],
              "properties": {
                "floci": { "type": "string", "format": "ipv4" },
                "headscale": { "type": "string", "format": "ipv4" },
                "origin_registry": { "type": "string", "format": "ipv4" }
              }
            }
          }
        }
      }
    }
  }
}
