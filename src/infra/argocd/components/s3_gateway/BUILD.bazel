"""Defines build and check targets for the s3_gateway Argo CD component."""

# gazelle:resolve py yaml @dev_python_deps//pyyaml

load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template")
load("@rules_kustomize//kustomize:kustomize.bzl", "kustomization", "kustomized_resources")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

kustomization(
    name = "base",
    srcs = glob(["kustomize/**"]),
    file = "kustomize/kustomization.yaml",
)

kustomized_resources(
    name = "base_render",
    kustomization = ":base",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "base_manifest",
    rendered = ":base_render",
)

helm_chart(
    name = "chart",
    chart = "helm/Chart.yaml",
    schema = "helm/values.schema.json",
    templates = glob(
        ["helm/templates/**"],
        allow_empty = True,
    ),
    values = "helm/values.yaml",
)

helm_lint_test(
    name = "helm-lint",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values.yaml"],
)

helm_template(
    name = "helm_render",
    chart = ":chart",
    values = ["helm/lint-values.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm",
    rendered = ":helm_render",
)

source_set(
    name = "helm_templates",
    srcs = glob(["helm/templates/**"]),
    kind = HELM_TEMPLATE,
)

package_sources(exclude = ["helm/templates/**"])
