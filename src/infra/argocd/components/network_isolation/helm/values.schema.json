{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaces"],
  "properties": {
    "namespaces": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 63,
        "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
      }
    }
  }
}
