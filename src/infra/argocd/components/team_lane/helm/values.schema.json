              "email": { "type": "string", "format": "email" },
              "roles": {
                "type": "array",
                "items": { "enum": ["dev", "ops"] },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["id", "email", "roles"],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "dev": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "ops": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      }
    }
