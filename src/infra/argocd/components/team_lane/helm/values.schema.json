{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accessAliasDomain",
    "delivery",
    "enabledPacks",
    "projectIndex",
    "registeredClusters",
    "repository",
    "resourcePacks",
    "team"
  ],
  "properties": {
    "accessAliasDomain": {
      "type": "string",
      "pattern": "^(?:c|k8s)\\.[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
      "not": { "pattern": "\\.localhost$" }
    },
    "awsAccountId": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "ecrRegistry": {
      "$ref": "#/definitions/repository"
    },
    "registeredClusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "server"],
        "properties": {
          "annotations": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "labels": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "name": { "$ref": "#/definitions/dnsLabel" },
          "server": { "type": "string", "format": "uri" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "originRepositories"],
      "properties": {
        "originRepositories": { "$ref": "#/definitions/repositoryMap" },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/image" }
        }
      }
    },
    "projectIndex": { "$ref": "#/definitions/projectIndex" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "url"],
      "properties": {
        "revision": { "type": "string", "pattern": "^(HEAD|[0-9a-f]{40}|[0-9a-f]{64})$" },
        "transportURL": { "type": "string", "pattern": "^((git|https)://|git@)[^\\s]+$" },
        "url": { "type": "string", "pattern": "^((git|https?)://|git@)[^\\s]+$" }
      }
    },
    "team": { "$ref": "#/definitions/team" },
    "enabledPacks": {
      "type": "array",
      "items": { "enum": ["cloudnative-pg", "keda", "kuberay"] },
      "uniqueItems": true
    },
    "resourcePacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "cloudnative-pg", "keda", "kuberay"],
      "properties": {
        "base": { "type": "array", "items": { "$ref": "#/definitions/resource" } },
        "cloudnative-pg": { "type": "array", "items": { "$ref": "#/definitions/resource" } },
        "keda": { "type": "array", "items": { "$ref": "#/definitions/resource" } },
        "kuberay": { "type": "array", "items": { "$ref": "#/definitions/resource" } }
      }
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(?:/[a-z0-9._-]+)*$"
    },
    "repositoryMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^src/[a-z0-9_/-]+$" },
      "additionalProperties": { "$ref": "#/definitions/repository" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestRepository", "package", "repository", "sourceName", "target"],
      "properties": {
        "manifestRepository": { "$ref": "#/definitions/repository" },
        "package": { "type": "string", "pattern": "^src/[a-z0-9_/-]+$" },
        "repository": { "type": "string", "pattern": "^src/[a-z0-9_/-]+$" },
        "sourceName": { "$ref": "#/definitions/dnsLabel" },
        "target": { "type": "string", "pattern": "^//src/[a-z0-9_/-]+:image_push$" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery", "deployments", "name", "path", "team"],
      "properties": {
        "delivery": { "enum": ["promoted", "submitted"] },
        "deployments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/projectDeployment" }
        },
        "name": { "$ref": "#/definitions/sourceName" },
        "path": {
          "type": "string",
          "pattern": "^src/[a-z0-9_]+(?:/[a-z0-9_]+)*$"
        },
        "team": { "$ref": "#/definitions/dnsLabel" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "delivery": { "const": "promoted" } },
            "required": ["delivery"]
          },
          "then": {
            "properties": {
              "deployments": {
                "items": { "required": ["promotion", "source", "stage"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "delivery": { "const": "submitted" } },
            "required": ["delivery"]
          },
          "then": {
            "properties": {
              "deployments": {
                "items": {
                  "not": {
                    "anyOf": [
                      { "required": ["promotion"] },
                      { "required": ["source"] },
                      { "required": ["stage"] }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "projectDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^src/[a-z0-9_]+(?:/[a-z0-9_]+)*$"
        },
        "promotion": { "enum": ["automatic", "manual"] },
        "source": { "$ref": "#/definitions/promotionSource" },
        "stage": { "$ref": "#/definitions/sourceName" }
      }
    },
    "promotionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["stage", "warehouse"] },
        "name": { "$ref": "#/definitions/sourceName" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "stage" } }, "required": ["kind"] },
          "then": { "required": ["name"] },
          "else": { "not": { "required": ["name"] } }
        }
      ]
    },
    "projectIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "version"],
      "properties": {
        "version": { "const": 3 },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/definitions/project" }
        }
      }
    },
    "sourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "propertyNames": { "enum": ["cloud", "name", "provider", "region", "role"] },
          "additionalProperties": { "type": "string" }
        },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "enum": ["cloud", "name", "provider", "region", "role"] },
              "operator": { "enum": ["DoesNotExist", "Exists", "In", "NotIn"] },
              "values": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "operator": { "enum": ["In", "NotIn"] } },
                  "required": ["operator"]
                },
                "then": {
                  "required": ["values"],
                  "properties": { "values": { "minItems": 1 } }
                }
              },
              {
                "if": {
                  "properties": { "operator": { "enum": ["DoesNotExist", "Exists"] } },
                  "required": ["operator"]
                },
                "then": {
                  "properties": { "values": { "maxItems": 0 } }
                }
              }
            ]
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "apiGroup", "kind", "project", "resource"],
      "properties": {
        "access": { "enum": ["edit", "view"] },
        "apiGroup": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "project": { "type": "boolean" },
        "resource": { "type": "string", "minLength": 1 }
      }
    },
    "quotaClasses": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "be": { "$ref": "#/definitions/quotaResources" },
        "ha": { "$ref": "#/definitions/quotaResources" },
        "ma": { "$ref": "#/definitions/quotaResources" },
        "wa": { "$ref": "#/definitions/quotaResources" }
      }
    },
    "accelerators": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "a10": { "type": "string", "pattern": "^[0-9]+$" },
        "a100-40gb": { "type": "string", "pattern": "^[0-9]+$" },
        "a100-80gb": { "type": "string", "pattern": "^[0-9]+$" },
        "a10g": { "type": "string", "pattern": "^[0-9]+$" },
        "b200": { "type": "string", "pattern": "^[0-9]+$" },
        "b300": { "type": "string", "pattern": "^[0-9]+$" },
        "h100": { "type": "string", "pattern": "^[0-9]+$" },
        "h100-nvl-94gb": { "type": "string", "pattern": "^[0-9]+$" },
        "h200": { "type": "string", "pattern": "^[0-9]+$" },
        "l4": { "type": "string", "pattern": "^[0-9]+$" },
        "l40s": { "type": "string", "pattern": "^[0-9]+$" },
        "rtx-pro-server-6000": { "type": "string", "pattern": "^[0-9]+$" },
        "t4": { "type": "string", "pattern": "^[0-9]+$" },
        "v100": { "type": "string", "pattern": "^[0-9]+$" },
        "v5e-2x2": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "quotaResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "accelerators": { "$ref": "#/definitions/accelerators" },
        "a10": { "type": "string", "pattern": "^[0-9]+$" },
        "a100-40gb": { "type": "string", "pattern": "^[0-9]+$" },
        "a100-80gb": { "type": "string", "pattern": "^[0-9]+$" },
        "a10g": { "type": "string", "pattern": "^[0-9]+$" },
        "b200": { "type": "string", "pattern": "^[0-9]+$" },
        "b300": { "type": "string", "pattern": "^[0-9]+$" },
        "cpu": { "type": "string", "pattern": "^[0-9]+$" },
        "google.com/tpu": { "type": "string", "pattern": "^[0-9]+$" },
        "h100": { "type": "string", "pattern": "^[0-9]+$" },
        "h100-nvl-94gb": { "type": "string", "pattern": "^[0-9]+$" },
        "h200": { "type": "string", "pattern": "^[0-9]+$" },
        "l4": { "type": "string", "pattern": "^[0-9]+$" },
        "l40s": { "type": "string", "pattern": "^[0-9]+$" },
        "memory": { "type": "string", "pattern": "^(0|[1-9][0-9]*Gi)$" },
        "nvidia.com/gpu": { "type": "string", "pattern": "^[0-9]+$" },
        "rtx-pro-server-6000": { "type": "string", "pattern": "^[0-9]+$" },
        "t4": { "type": "string", "pattern": "^[0-9]+$" },
        "v100": { "type": "string", "pattern": "^[0-9]+$" },
        "v5e-2x2": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive", "cells", "projects", "promotion", "quota", "slug"],
      "properties": {
        "slug": {
          "type": "string",
          "maxLength": 31,
          "pattern": "^[a-z][a-z0-9]{1,30}$"
        },
        "cells": { "$ref": "#/definitions/labelSelector" },
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/sourceName" },
          "uniqueItems": true
        },
        "dev_secrets": {
          "description": "Debug-tier secret names declared by the team; never use them as workload or production credentials.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 81,
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classes"],
          "properties": {
            "classes": { "$ref": "#/definitions/quotaClasses" },
            "cells": {
              "type": "object",
              "propertyNames": {
                "pattern": "^cell-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["classes"],
                "properties": {
                  "classes": { "$ref": "#/definitions/quotaClasses" }
                }
              }
            }
          }
        },
        "promotion": { "enum": ["automatic", "manual", "triggered"] },
        "readers": { "enum": ["all", "members"] },
        "submitters": { "enum": ["all", "members"] },
        "archive": { "type": "boolean" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "email": { "type": "string", "format": "email" },
              "roles": {
                "type": "array",
                "items": { "enum": ["dev", "ops"] },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["id", "email", "roles"],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "dev": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "ops": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
