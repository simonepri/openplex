          "uniqueItems": true
        },
        "dev_secrets": {
          "description": "Debug-tier secret names readable by every developer and process in the team's workspaces, including coding agents; never use them as workload or production credentials.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 81,
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
