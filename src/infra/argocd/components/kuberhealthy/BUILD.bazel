"""Defines build and check targets for the kuberhealthy Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_template")
load("@rules_kustomize//kustomize:kustomize.bzl", "kustomization", "kustomized_resources")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

kustomization(
    name = "base",
    srcs = glob(["kustomize/**"]),
    file = "kustomize/kustomization.yaml",
)

kustomized_resources(
    name = "base_render",
    kustomization = ":base",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "base_manifest",
    rendered = ":base_render",
)

helm_template(
    name = "vendor-helm-render",
    chart = "@vendor_helm_kuberhealthy//:kuberhealthy",
    opts = [
        "--include-crds",
        "--namespace",
        "manifest-checks",
    ],
    values = [
        "helm/values.yaml",
    ],
)

package_sources(exclude = [
    "**/*.sh",
    "**/*.py",
])

manifest_checks(
    name = "vendor-helm",
    kube_lint_config = "//src/bazel/rules/kubernetes_manifests:kube-linter-vendor.yaml",
    rendered = ":vendor-helm-render",
)

sh_library(
    name = "shell",
    srcs = [
        "kustomize/run-chainsaw-check.sh",
        "kustomize/run-chainsaw-smoke-apiserver.sh",
        "kustomize/run-chainsaw-smoke-check.sh",
        "kustomize/run-chainsaw-smoke-cli.sh",
        "kustomize/run-chainsaw-smoke-dns.sh",
    ],
)

kustomization(
    name = "tests-identity-fixtures-identity",
    srcs = glob(["kustomize/tests/identity/fixtures/identity/**"]),
    file = "kustomize/tests/identity/fixtures/identity/kustomization.yaml",
)

kustomized_resources(
    name = "tests-identity-fixtures-identity_render",
    kustomization = ":tests-identity-fixtures-identity",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "tests-identity-fixtures-identity_manifest",
    rendered = ":tests-identity-fixtures-identity_render",
)

py_library(
    name = "python",
    srcs = ["kustomize/tests/identity/fixtures/identity/login.py"],
    imports = ["kustomize/tests/identity/fixtures/identity"],
)
