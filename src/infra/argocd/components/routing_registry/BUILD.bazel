"""Defines build and check targets for the routing_registry Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

helm_chart(
    name = "chart",
    chart = "helm/Chart.yaml",
    schema = "helm/values.schema.json",
    templates = glob(
        ["helm/templates/**"],
        allow_empty = True,
    ),
    values = "helm/values.yaml",
)

helm_lint_test(
    name = "helm-lint-cell",
    chart = ":chart",
    opts = ["--strict"],
    values = [
        "helm/routes.yaml",
        "helm/lint-values-cell.yaml",
    ],
)

helm_template(
    name = "helm_render-cell",
    chart = ":chart",
    values = [
        "helm/routes.yaml",
        "helm/lint-values-cell.yaml",
    ],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-cell",
    rendered = ":helm_render-cell",
)

