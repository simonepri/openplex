"""Check targets for the tailscale_operator Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_import", "helm_template")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

package_sources()

helm_import(
    name = "vendor_chart",
    chart = "@vendor_helm_tailscale_operator//file",
    version = "1.102.4",
)

helm_template(
    name = "vendor-helm-render",
    chart = ":vendor_chart",
    opts = [
        "--include-crds",
        "--namespace",
        "manifest-checks",
    ],
    values = ["helm/values.yaml"],
)

manifest_checks(
    name = "vendor-helm",
    kube_lint_config = "//src/bazel/rules/kubernetes_manifests:kube-linter-vendor.yaml",
    rendered = ":vendor-helm-render",
)
