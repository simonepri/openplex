"""Defines build and check targets for the parca_agent Argo CD component."""

load("@rules_kustomize//kustomize:kustomize.bzl", "kustomization", "kustomized_resources")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

kustomization(
    name = "base",
    srcs = glob(["kustomize/**"]),
    file = "kustomize/kustomization.yaml",
)

kustomized_resources(
    name = "base_render",
    kustomization = ":base",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "base_manifest",
    rendered = ":base_render",
)

package_sources()

kustomization(
    name = "agent",
    srcs = glob(["kustomize/agent/**"]),
    file = "kustomize/agent/kustomization.yaml",
)

kustomized_resources(
    name = "agent_render",
    kustomization = ":agent",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "agent_manifest",
    rendered = ":agent_render",
)

kustomization(
    name = "agent_gpu",
    srcs = glob([
        "kustomize/agent_gpu/**",
        "kustomize/agent/**",
    ]),
    file = "kustomize/agent_gpu/kustomization.yaml",
)

kustomized_resources(
    name = "agent_gpu_render",
    kustomization = ":agent_gpu",
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "agent_gpu_manifest",
    rendered = ":agent_gpu_render",
)
