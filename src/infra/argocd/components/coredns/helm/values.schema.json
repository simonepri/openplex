{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider"],
  "properties": {
    "provider": {
      "enum": ["floci", "gcp"]
    },
    "serviceCIDR": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}0\\/(?:1[2-9]|2[0-4])$"
    },
    "rewrites": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*\\.svc\\.cluster\\.local$"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "repository", "tag"],
      "properties": {
        "repository": { "const": "registry.k8s.io/coredns/coredns" },
        "tag": { "const": "v1.14.7" },
        "digest": {
          "const": "sha256:7efd3c635b03efd68c4e8398fc45f0d993d0e9ab016f72c1cefb0fd6d01aa286"
        }
      }
    },
    "accessAliasDomain": {
      "type": "string",
      "pattern": "^(?:c|k8s)\\.[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
      "not": { "pattern": "\\.localhost$" }
    },
    "publicDomain": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
      "not": { "pattern": "\\.localhost$" }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "pattern": "^(ctrl|cell)-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
        "role": { "enum": ["cell", "ctrl"] }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gatewayIPv4", "name", "originRegistryIPv4"],
      "properties": {
        "name": { "type": "string", "pattern": "^ctrl-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
        "gatewayIPv4": { "type": "string", "format": "ipv4" },
        "headscaleIPv4": {
          "oneOf": [{ "const": "" }, { "type": "string", "format": "ipv4" }]
        },
        "originRegistryIPv4": { "type": "string", "format": "ipv4" }
      }
    },
    "internalDomain": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)+$"
    },
    "privateAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseDomain", "coderAppsWildcard", "gatewayIPv4", "recordLabels"],
      "properties": {
        "baseDomain": {
          "type": "string",
          "pattern": "^(?:cell|ctrl)-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?\\.(?:c|k8s)\\.[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
          "not": { "pattern": "\\.localhost$" }
        },
        "coderAppsWildcard": { "type": "boolean" },
        "gatewayIPv4": { "type": "string", "format": "ipv4" },
        "recordLabels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" }
        }
      }
    },
    "cellDomains": {
      "type": "object",
      "propertyNames": { "pattern": "^cell-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$",
        "not": { "pattern": "\\.localhost$" }
      }
    },
    "cellIPv4s": {
      "type": "object",
      "propertyNames": { "pattern": "^cell-[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$" },
      "additionalProperties": { "type": "string", "format": "ipv4" }
    }
  }
}
