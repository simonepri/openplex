"""Check targets for the envoy_gateway_instance Argo CD component."""

load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "HELM_TEMPLATE", "package_sources", "source_set")
load("//src/bazel/rules/kubernetes_manifests:defs.bzl", "manifest_checks")

helm_chart(
    name = "chart",
    chart = "helm/Chart.yaml",
    schema = "helm/values.schema.json",
    templates = glob(
        ["helm/templates/**"],
        allow_empty = True,
    ),
    values = "helm/values.yaml",
)

helm_lint_test(
    name = "helm-lint-cell",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-cell.yaml"],
)

helm_template(
    name = "helm_render-cell",
    chart = ":chart",
    values = ["helm/lint-values-cell.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-cell",
    rendered = ":helm_render-cell",
)

helm_lint_test(
    name = "helm-lint-cloud",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-cloud.yaml"],
)

helm_template(
    name = "helm_render-cloud",
    chart = ":chart",
    values = ["helm/lint-values-cloud.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-cloud",
    rendered = ":helm_render-cloud",
)

helm_lint_test(
    name = "helm-lint-local",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-local.yaml"],
)

helm_template(
    name = "helm_render-local",
    chart = ":chart",
    values = ["helm/lint-values-local.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-local",
    rendered = ":helm_render-local",
)

helm_lint_test(
    name = "helm-lint-private-access",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values-private-access.yaml"],
)

helm_template(
    name = "helm_render-private-access",
    chart = ":chart",
    values = ["helm/lint-values-private-access.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm-private-access",
    rendered = ":helm_render-private-access",
)

helm_lint_test(
    name = "helm-lint",
    chart = ":chart",
    opts = ["--strict"],
    values = ["helm/lint-values.yaml"],
)

helm_template(
    name = "helm_render",
    chart = ":chart",
    values = ["helm/lint-values.yaml"],
    visibility = ["//visibility:public"],
)

manifest_checks(
    name = "helm",
    rendered = ":helm_render",
)

source_set(
    name = "helm_templates",
    srcs = glob(["helm/templates/**"]),
    kind = HELM_TEMPLATE,
)

package_sources(exclude = ["helm/templates/**"])
