"""Defines OpenTofu module check targets for GCP Cloud DNS managed zones and resource records."""

load("@rules_tf//tf:def.bzl", "tf_module")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")

tf_module(
    name = "gcp",
    providers = [
        "google",
    ],
    skip_validation = True,
    deps = [
        "//src/infra/terraform/components/dns/_interface",
    ],
)

package_sources()
