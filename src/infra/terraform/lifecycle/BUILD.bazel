"""Defines Python check and execution targets for cluster lifecycle and GitOps bootstrap automation."""

# gazelle:resolve_regexp py ^infra\.tools\.cloud_emulator\.engine\.([^.]+)(\..*)?$ //src/infra/tools/cloud_emulator/engine:$1
# gazelle:resolve py infra.tools.cloud_emulator.access.cluster_tailnet //src/infra/tools/cloud_emulator/access:cluster_tailnet
# gazelle:resolve py infra.tools.cloud_emulator.access.kubeconfig //src/infra/tools/cloud_emulator/access:kubeconfig
# gazelle:resolve py infra.tools.cloud_emulator.auth.headscale_keys //src/infra/tools/cloud_emulator/auth:headscale_keys
# gazelle:resolve py infra.terraform.lifecycle.cluster_up //src/infra/terraform/lifecycle:cluster_up_lib
# gazelle:resolve_regexp py ^infra\.terraform\.lifecycle\.([^.]+)(\..*)?$ //src/infra/terraform/lifecycle:$1

load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")

py_library(
    name = "cluster_common",
    srcs = ["cluster_common.py"],
    imports = ["../../.."],  # keep
    visibility = ["//visibility:public"],
)

py_library(
    name = "cluster_up_lib",
    srcs = ["cluster_up.py"],
    imports = ["../../.."],  # keep
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
        "//src/infra/tools/cloud_emulator/access:kubeconfig",
        "//src/infra/tools/cloud_emulator/auth:headscale_keys",
        "//src/infra/tools/cloud_emulator/engine:compose",
        "//src/infra/tools/cloud_emulator/engine:docker",
        "//src/infra/tools/cloud_emulator/engine:readiness",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "cluster_up",
    srcs = ["cluster_up.py"],
    data = ["//src/infra/images:seed"],
    # LINT.IfChange(seed-rlocationpath-variable)
    env = {"CLUSTER_SEED_RLOCATIONPATH": "$(rlocationpath //src/infra/images:seed)"},
    # LINT.ThenChange(//src/infra/terraform/lifecycle/cluster_up.py:seed-rlocationpath-variable)
    imports = ["../../.."],  # keep
    visibility = ["//visibility:public"],
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
        "//src/infra/tools/cloud_emulator/access:kubeconfig",
        "//src/infra/tools/cloud_emulator/auth:headscale_keys",
        "//src/infra/tools/cloud_emulator/engine:compose",
        "//src/infra/tools/cloud_emulator/engine:docker",
        "//src/infra/tools/cloud_emulator/engine:readiness",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "cluster_down",
    srcs = ["cluster_down.py"],
    imports = ["../../.."],  # keep
    visibility = ["//visibility:public"],
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
        "//src/infra/tools/cloud_emulator/engine:compose",
        "//src/infra/tools/cloud_emulator/engine:docker",
        "//src/infra/tools/cloud_emulator/engine:storage",
    ],
)

alias(
    name = "up",
    actual = ":cluster_up",
    visibility = ["//visibility:public"],
)

alias(
    name = "down",
    actual = ":cluster_down",
    visibility = ["//visibility:public"],
)

package_sources()
