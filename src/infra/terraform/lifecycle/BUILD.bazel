"""Defines Python check and execution targets for cluster lifecycle and GitOps bootstrap automation."""

# gazelle:resolve py infra.tools.cloud_emulator.runtime //src/infra/tools/cloud_emulator:runtime
# gazelle:resolve py infra.tools.cloud_emulator //src/infra/tools/cloud_emulator:runtime
# gazelle:resolve py infra.tools.cloud_emulator.access.cluster_tailnet //src/infra/tools/cloud_emulator/access:cluster_tailnet
# gazelle:resolve py infra.terraform.lifecycle.cluster_up //src/infra/terraform/lifecycle:cluster_up_lib
# gazelle:resolve_regexp py ^infra\.terraform\.lifecycle\.([^.]+)(\..*)?$ //src/infra/terraform/lifecycle:$1

load("@aspect_bazel_lib//lib:output_files.bzl", "output_files")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")

py_library(
    name = "cluster_common",
    srcs = ["cluster_common.py"],
    imports = ["../../.."],  # keep
    visibility = ["//visibility:public"],
)

py_library(
    name = "cluster_up_lib",
    srcs = ["cluster_up.py"],
    imports = ["../../.."],  # keep
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/tools/cloud_emulator:runtime",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
        "//src/infra/tools/cloud_emulator/access:kubeconfig",
        "//src/infra/tools/cloud_emulator/auth:headscale_keys",
        "@rules_python//python/runfiles",
    ],
)

py_binary(
    name = "cluster_up",
    srcs = ["cluster_up.py"],
    data = ["//src/infra/images:seed"],
    # LINT.IfChange(seed-rlocationpath-variable)
    env = {"CLUSTER_SEED_RLOCATIONPATH": "$(rlocationpath //src/infra/images:seed)"},
    # LINT.ThenChange(//src/infra/terraform/lifecycle/cluster_up.py:seed-rlocationpath-variable)
    imports = ["../../.."],  # keep
    visibility = ["//visibility:public"],
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/tools/cloud_emulator:runtime",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
        "//src/infra/tools/cloud_emulator/access:kubeconfig",
        "//src/infra/tools/cloud_emulator/auth:headscale_keys",
        "@rules_python//python/runfiles",
    ],
)

# The seed wrapper alone, without the image publishers in its runfiles.
output_files(
    name = "seed_wrapper",
    paths = ["src/infra/images/seed.bash"],
    target = "//src/infra/images:seed",
)

py_binary(
    name = "cluster_down",
    srcs = ["cluster_down.py"],
    imports = ["../../.."],  # keep
    visibility = ["//visibility:public"],
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/tools/cloud_emulator:runtime",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
    ],
)

py_test(
    name = "cluster_lifecycle_test",
    srcs = ["cluster_lifecycle_test.py"],
    data = [
        ":seed_wrapper",
        "@bazel_tools//tools/bash/runfiles",
    ],
    env = {"CLUSTER_SEED_RLOCATIONPATH": "$(rlocationpath :seed_wrapper)"},
    imports = ["../../.."],  # keep
    tags = ["no-sandbox"],
    deps = [
        "//src/infra/terraform/lifecycle:cluster_common",
        "//src/infra/terraform/lifecycle:cluster_down",
        "//src/infra/terraform/lifecycle:cluster_up_lib",
        "//src/infra/tools/cloud_emulator/access:cluster_tailnet",
    ],
)

alias(
    name = "up",
    actual = ":cluster_up",
    visibility = ["//visibility:public"],
)

alias(
    name = "down",
    actual = ":cluster_down",
    visibility = ["//visibility:public"],
)

package_sources()
