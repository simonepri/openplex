"""Packages and seeds platform and workload container images."""

load("@rules_multirun//:defs.bzl", "command", "multirun")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//src/bazel/rules/build_graph_coverage:defs.bzl", "package_sources")

exports_files([
    "infrastructure-images.json",
    "workload-images.json",
])

command(
    name = "seed",
    command = ":seed_images",
    environment = {
        "WORKLOAD_STREAM_TAG": "",
        "WORKLOAD_TAG_PREFIX": "ci",
    },
    visibility = ["//visibility:public"],
)

multirun(
    name = "seed_images",
    commands = [
        "//src/infra/definitions/workspaces/templates/dev:seed",
        "//src/infra/tools/coder_snapshot_portal:publish",
        "//src/third_party/dragonflyoss/client:publish",
        "//src/infra/tools/dragonfly_sso:publish",
        "//src/third_party/openebs/rawfile-localpv:publish",
        "//src/infra/tools/s3_resolver/server:publish",
        "//src/infra/tools/workspace_backup_proxy:publish",
        "//src/infra/tools/workspace_healer:publish",
        "//src/examples/batch_cron:publish",
        "//src/examples/ray_data:publish",
        "//src/examples/ray_serve:publish",
        "//src/examples/ray_train:publish",
        "//src/examples/svelte_web:publish",
    ],
    jobs = 0,
)

py_binary(
    name = "generate",
    srcs = ["generate.py"],
    data = [
        ":infrastructure-images.json",
        "//src/infra/argocd/apps:cells.yaml",
        "//src/infra/argocd/apps:ctrl.yaml",
    ],
)

py_test(
    name = "generate_test",
    srcs = ["generate.py"],
    args = [
        "--check",
        "--inventory=$(location :infrastructure-images.json)",
        "--ctrl=$(location //src/infra/argocd/apps:ctrl.yaml)",
        "--cells=$(location //src/infra/argocd/apps:cells.yaml)",
    ],
    data = [
        ":infrastructure-images.json",
        "//src/infra/argocd/apps:cells.yaml",
        "//src/infra/argocd/apps:ctrl.yaml",
    ],
    main = "generate.py",
)

py_test(
    name = "infrastructure_images_test",
    srcs = ["infrastructure_images_test.py"],
    data = [
        ":infrastructure-images.json",
        "//.github:renovate.json",
        "//src/infra/argocd/apps:cells.yaml",
        "//src/infra/argocd/apps:ctrl.yaml",
        "//src/infra/argocd/components/kyverno:kustomize/policies.yaml",
    ],
)

package_sources()
